namespace sublang::backend::llvmdata;

public class SublangLlvmListRuntime {
    public static String definitions() {
        String text = "%sublang.list = type { ptr, i32, i32 }\ndeclare ptr @realloc(ptr, i64)\ndeclare { i64, i1 } @llvm.umul.with.overflow.i64(i64, i64)\n";
        text = text + "define internal ptr @sublang.list.push.slot(ptr %list, i64 %size) {\nentry:\n  %ls = getelementptr %sublang.list, ptr %list, i32 0, i32 1\n  %cs = getelementptr %sublang.list, ptr %list, i32 0, i32 2\n  %len32 = load i32, ptr %ls\n  %cap32 = load i32, ptr %cs\n  %len = zext i32 %len32 to i64\n  %cap = zext i32 %cap32 to i64\n  %full = icmp eq i64 %len, 2147483647\n  br i1 %full, label %bad, label %check\nbad:\n  call void @abort()\n  unreachable\ncheck:\n  %grow = icmp eq i64 %len, %cap\n  br i1 %grow, label %resize, label %place\nresize:\n  %double = mul i64 %cap, 2\n  %small = icmp ult i64 %double, 8\n  %base = select i1 %small, i64 8, i64 %double\n  %large = icmp ugt i64 %base, 2147483647\n  %newcap = select i1 %large, i64 2147483647, i64 %base\n  %product = call { i64, i1 } @llvm.umul.with.overflow.i64(i64 %newcap, i64 %size)\n  %bytes = extractvalue { i64, i1 } %product, 0\n  %overflow = extractvalue { i64, i1 } %product, 1\n  br i1 %overflow, label %bad, label %allocate\nallocate:\n  %old = load ptr, ptr %list\n  %new = call ptr @realloc(ptr %old, i64 %bytes)\n  %null = icmp eq ptr %new, null\n  br i1 %null, label %bad, label %save\nsave:\n  store ptr %new, ptr %list\n  %newcap32 = trunc i64 %newcap to i32\n  store i32 %newcap32, ptr %cs\n  br label %place\nplace:\n  %data = load ptr, ptr %list\n  %offset = mul i64 %len, %size\n  %slot = getelementptr i8, ptr %data, i64 %offset\n  %next = add i32 %len32, 1\n  store i32 %next, ptr %ls\n  ret ptr %slot\n}\n";
        text = text + "define internal ptr @sublang.list.at(ptr %list, i64 %index, i64 %size) {\nentry:\n  %ls = getelementptr %sublang.list, ptr %list, i32 0, i32 1\n  %len32 = load i32, ptr %ls\n  %len = zext i32 %len32 to i64\n  %valid = icmp ult i64 %index, %len\n  br i1 %valid, label %ok, label %bad\nbad:\n  call void @abort()\n  unreachable\nok:\n  %data = load ptr, ptr %list\n  %offset = mul i64 %index, %size\n  %slot = getelementptr i8, ptr %data, i64 %offset\n  ret ptr %slot\n}\n";
        return text;
    }
}
