namespace sublang::backend::llvmbond;

// Candidate-local trial deletion, following the original Flow algorithm: gather
// forward closure, subtract internal edges, propagate external reachability,
// unlink every victim edge, then release victims. Intrusive scan links avoid
// temporary hash tables and preserve bounded auxiliary allocation.
public class SublangLlvmBondTrial {
    public static String definitions() {
        String text = "@sublang.bond.phase = internal global i32 0\n@sublang.bond.scan = internal global ptr null\n@sublang.bond.scan.count = internal global i64 0\n";
        return text + SublangLlvmBondTrial.enqueue() + SublangLlvmBondTrial.edge() + SublangLlvmBondTrial.work() + SublangLlvmBondTrial.run() + SublangLlvmBondTrial.collect();
    }

    private static String enqueue() {
        String text = "define internal void @sublang.bond.trial.enqueue(ptr %payload) {\nentry:\n  %null = icmp eq ptr %payload, null\n  br i1 %null, label %done, label %check\ncheck:\n  %meta = call ptr @sublang.bond.meta(ptr %payload)\n  %ms = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 3\n  %marked = load i1, ptr %ms\n  br i1 %marked, label %done, label %add\nadd:\n  store i1 true, ptr %ms\n  %rs = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 2\n  %is = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 7\n  %ts = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 8\n  %roots = load i64, ptr %rs\n  %incoming = load i64, ptr %is\n  %total = add i64 %roots, %incoming\n  store i64 %total, ptr %ts\n  %as = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 10\n  store i1 false, ptr %as\n  %reverse = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 12\n  store i1 false, ptr %reverse\n  %ss = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 9\n  %scan = load ptr, ptr @sublang.bond.scan\n  store ptr %scan, ptr %ss\n  store ptr %meta, ptr @sublang.bond.scan\n  %count = load i64, ptr @sublang.bond.scan.count\n  %more = add i64 %count, 1\n  store i64 %more, ptr @sublang.bond.scan.count\n  %ws = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 6\n  %work = load ptr, ptr @sublang.bond.work\n  store ptr %work, ptr %ws\n  store ptr %meta, ptr @sublang.bond.work\n  br label %done\ndone:\n  ret void\n}\n";
        return text + "define internal void @sublang.bond.trial.alive(ptr %payload) {\nentry:\n  %null = icmp eq ptr %payload, null\n  br i1 %null, label %done, label %check\ncheck:\n  %meta = call ptr @sublang.bond.meta(ptr %payload)\n  %ms = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 3\n  %member = load i1, ptr %ms\n  %as = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 10\n  %alive = load i1, ptr %as\n  %new = xor i1 %alive, true\n  %visit = and i1 %member, %new\n  br i1 %visit, label %push, label %done\npush:\n  store i1 true, ptr %as\n  %ws = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 6\n  %work = load ptr, ptr @sublang.bond.work\n  store ptr %work, ptr %ws\n  store ptr %meta, ptr @sublang.bond.work\n  br label %done\ndone:\n  ret void\n}\n";
    }

    private static String edge() {
        return "define internal void @sublang.bond.trial.edge(ptr %child, i32 %phase) {\nentry:\n  switch i32 %phase, label %done [ i32 2, label %gather i32 3, label %subtract i32 4, label %reach i32 5, label %reverse i32 6, label %cache.subtract ]\ngather:\n  call void @sublang.bond.trial.enqueue(ptr %child)\n  ret void\nreach:\n  call void @sublang.bond.trial.alive(ptr %child)\n  ret void\nreverse:\n  call void @sublang.bond.cache.reverse.edge(ptr %child)\n  ret void\ncache.subtract:\n  call void @sublang.bond.cache.subtract(ptr %child)\n  ret void\nsubtract:\n  %null = icmp eq ptr %child, null\n  br i1 %null, label %done, label %inspect\ninspect:\n  %meta = call ptr @sublang.bond.meta(ptr %child)\n  %ms = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 3\n  %member = load i1, ptr %ms\n  br i1 %member, label %decrement, label %done\ndecrement:\n  %ts = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 8\n  %old = load i64, ptr %ts\n  %next = sub i64 %old, 1\n  store i64 %next, ptr %ts\n  br label %done\ndone:\n  ret void\n}\n";
    }

    private static String work() {
        return "define internal void @sublang.bond.trial.work() {\nentry:\n  br label %loop\nloop:\n  %meta = load ptr, ptr @sublang.bond.work\n  %empty = icmp eq ptr %meta, null\n  br i1 %empty, label %done, label %visit\nvisit:\n  %ws = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 6\n  %next = load ptr, ptr %ws\n  store ptr %next, ptr @sublang.bond.work\n  %ts = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 4\n  %callback = load ptr, ptr %ts\n  %ps = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 5\n  %payload = load ptr, ptr %ps\n  call void %callback(ptr %payload, i1 false)\n  br label %loop\ndone:\n  ret void\n}\n";
    }

    private static String run() {
        String text = "define internal void @sublang.bond.trial.run(ptr %candidate) {\nentry:\n  store ptr null, ptr @sublang.bond.scan\n  store i64 0, ptr @sublang.bond.scan.count\n  store i32 2, ptr @sublang.bond.phase\n  %ps = getelementptr %sublang.bond.meta, ptr %candidate, i32 0, i32 5\n  %payload = load ptr, ptr %ps\n  call void @sublang.bond.trial.enqueue(ptr %payload)\n  call void @sublang.bond.trial.work()\n  store i32 3, ptr @sublang.bond.phase\n  %head = load ptr, ptr @sublang.bond.scan\n  br label %subtract\nsubtract:\n  %node = phi ptr [ %head, %entry ], [ %next, %subtract.visit ]\n  %empty = icmp eq ptr %node, null\n  br i1 %empty, label %seed.start, label %subtract.visit\nsubtract.visit:\n  %ss = getelementptr %sublang.bond.meta, ptr %node, i32 0, i32 9\n  %next = load ptr, ptr %ss\n  %ts = getelementptr %sublang.bond.meta, ptr %node, i32 0, i32 4\n  %callback = load ptr, ptr %ts\n  %os = getelementptr %sublang.bond.meta, ptr %node, i32 0, i32 5\n  %object = load ptr, ptr %os\n  call void %callback(ptr %object, i1 false)\n  br label %subtract\nseed.start:\n  store i32 4, ptr @sublang.bond.phase\n  br label %seed\nseed:\n  %seed.node = phi ptr [ %head, %seed.start ], [ %seed.next, %seed.advance ]\n  %seed.empty = icmp eq ptr %seed.node, null\n  br i1 %seed.empty, label %propagate, label %seed.check\nseed.check:\n  %seed.ts = getelementptr %sublang.bond.meta, ptr %seed.node, i32 0, i32 8\n  %trial = load i64, ptr %seed.ts\n  %external = icmp ne i64 %trial, 0\n  br i1 %external, label %seed.mark, label %seed.advance\nseed.mark:\n  %seed.ps = getelementptr %sublang.bond.meta, ptr %seed.node, i32 0, i32 5\n  %seed.payload = load ptr, ptr %seed.ps\n  call void @sublang.bond.trial.alive(ptr %seed.payload)\n  br label %seed.advance\nseed.advance:\n  %seed.ss = getelementptr %sublang.bond.meta, ptr %seed.node, i32 0, i32 9\n  %seed.next = load ptr, ptr %seed.ss\n  br label %seed\npropagate:\n  call void @sublang.bond.trial.work()\n  br label %count\ncount:\n  %count.node = phi ptr [ %head, %propagate ], [ %count.next, %count.step ]\n  %victims = phi i64 [ 0, %propagate ], [ %count.total, %count.step ]\n  %count.empty = icmp eq ptr %count.node, null\n  br i1 %count.empty, label %choose, label %count.step\ncount.step:\n  %count.as = getelementptr %sublang.bond.meta, ptr %count.node, i32 0, i32 10\n  %count.alive = load i1, ptr %count.as\n  %increment = select i1 %count.alive, i64 0, i64 1\n  %count.total = add i64 %victims, %increment\n  %count.ss = getelementptr %sublang.bond.meta, ptr %count.node, i32 0, i32 9\n  %count.next = load ptr, ptr %count.ss\n  br label %count\nchoose:\n  %no.victims = icmp eq i64 %victims, 0\n  br i1 %no.victims, label %cache, label %unlink.start\ncache:\n  call void @sublang.bond.cache.build(ptr %candidate)\n  br label %release.start\nunlink.start:\n  call void @sublang.bond.graph.changed()\n  br label %unlink\nunlink:\n  %unlink.node = phi ptr [ %head, %unlink.start ], [ %unlink.next, %unlink.advance ]\n  %unlink.empty = icmp eq ptr %unlink.node, null\n  br i1 %unlink.empty, label %release.start, label %unlink.check\nunlink.check:\n  %unlink.as = getelementptr %sublang.bond.meta, ptr %unlink.node, i32 0, i32 10\n  %unlink.alive = load i1, ptr %unlink.as\n  br i1 %unlink.alive, label %unlink.advance, label %unlink.visit\nunlink.visit:\n  %unlink.ts = getelementptr %sublang.bond.meta, ptr %unlink.node, i32 0, i32 4\n  %unlink.callback = load ptr, ptr %unlink.ts\n  %unlink.ps = getelementptr %sublang.bond.meta, ptr %unlink.node, i32 0, i32 5\n  %unlink.payload = load ptr, ptr %unlink.ps\n  call void %unlink.callback(ptr %unlink.payload, i1 true)\n  br label %unlink.advance\nunlink.advance:\n  %unlink.ss = getelementptr %sublang.bond.meta, ptr %unlink.node, i32 0, i32 9\n  %unlink.next = load ptr, ptr %unlink.ss\n  br label %unlink\nrelease.start:\n  br label %release\nrelease:\n  %release.node = phi ptr [ %head, %release.start ], [ %release.next, %keep ], [ %release.next, %free ]\n  %release.empty = icmp eq ptr %release.node, null\n  br i1 %release.empty, label %done, label %release.check\nrelease.check:\n  %release.ss = getelementptr %sublang.bond.meta, ptr %release.node, i32 0, i32 9\n  %release.next = load ptr, ptr %release.ss\n  %release.as = getelementptr %sublang.bond.meta, ptr %release.node, i32 0, i32 10\n  %release.alive = load i1, ptr %release.as\n  br i1 %release.alive, label %keep, label %free\nkeep:\n  %release.ms = getelementptr %sublang.bond.meta, ptr %release.node, i32 0, i32 3\n  store i1 false, ptr %release.ms\n  %release.cs = getelementptr %sublang.bond.meta, ptr %release.node, i32 0, i32 11\n  store i1 false, ptr %release.cs\n  br label %release\nfree:\n  call void @sublang.bond.trial.free(ptr %release.node)\n  br label %release\ndone:\n  store ptr null, ptr @sublang.bond.scan\n  store i32 0, ptr @sublang.bond.phase\n  ret void\n}\n";
        return text + SublangLlvmBondTrial.free();
    }

    private static String free() {
        return "define internal void @sublang.bond.trial.free(ptr %meta) {\nentry:\n  call void @sublang.bond.cache.drop(ptr %meta)\n  %next = load ptr, ptr %meta\n  %bs = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 1\n  %previous = load ptr, ptr %bs\n  %first = icmp eq ptr %previous, null\n  %slot = select i1 %first, ptr @sublang.bond.nodes, ptr %previous\n  store ptr %next, ptr %slot\n  %has.next = icmp ne ptr %next, null\n  br i1 %has.next, label %fix, label %release\nfix:\n  %next.back = getelementptr %sublang.bond.meta, ptr %next, i32 0, i32 1\n  store ptr %previous, ptr %next.back\n  br label %release\nrelease:\n  %ps = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 5\n  %payload = load ptr, ptr %ps\n  %header = getelementptr i8, ptr %payload, i64 -16\n  call void @free(ptr %header)\n  call void @free(ptr %meta)\n  ret void\n}\n";
    }

    private static String collect() {
        return "define internal void @sublang.bond.trial.collect() {\nentry:\n  %dirty = load i1, ptr @sublang.bond.dirty\n  br i1 %dirty, label %restart, label %done\nrestart:\n  %head = load ptr, ptr @sublang.bond.nodes\n  br label %search\nsearch:\n  %meta = phi ptr [ %head, %restart ], [ %next, %advance ]\n  %empty = icmp eq ptr %meta, null\n  br i1 %empty, label %finish, label %inspect\ninspect:\n  %cs = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 11\n  %candidate = load i1, ptr %cs\n  br i1 %candidate, label %take, label %advance\ntake:\n  store i1 false, ptr %cs\n  %rs = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 2\n  %roots = load i64, ptr %rs\n  %unrooted = icmp eq i64 %roots, 0\n  br i1 %unrooted, label %run, label %advance\nrun:\n  call void @sublang.bond.trial.run(ptr %meta)\n  br label %restart\nadvance:\n  %next = load ptr, ptr %meta\n  br label %search\nfinish:\n  store i1 false, ptr @sublang.bond.dirty\n  br label %done\ndone:\n  ret void\n}\n";
    }
}
