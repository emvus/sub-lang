namespace sublang::ir;

use sublang::ir::SublangField;
use sublang::ir::SublangFunction;
use sublang::ir::SublangSourceSpan;
use sublang::ir::SublangType;
use sublang::ir::SublangVocabulary;

// Module tables. All ids are 1-based positions in these tables and are never
// recycled; 0 means "missing". Primitive types get fixed ids: Void=1, Bool=2,
// Int=3 (64-bit signed), Float=4 (64-bit).
public class SublangModule {
    private String moduleName;
    private String stageName;
    private Int revisionNumber;
    private Int entryFunctionId;
    private Int operationCounter;
    private List<String> sourceNames;
    private List<SublangSourceSpan> spanList;
    private List<SublangType> typeList;
    private List<SublangField> fieldList;
    private List<SublangFunction> functionList;
    private List<String> failureNames;

    public SublangModule(String name) {
        this.moduleName = name + "";
        this.stageName = SublangVocabulary.stageHigh();
        this.revisionNumber = 1;
        this.entryFunctionId = 0;
        this.operationCounter = 0;
        this.sourceNames = List();
        this.spanList = List();
        this.typeList = List();
        this.fieldList = List();
        this.functionList = List();
        this.failureNames = List();
        this.addType("Void", "Void", 0, false, 0, 0);
        this.addType("Bool", "Bool", 1, false, 0, 0);
        this.addType("Int", "Int", 64, true, 0, 0);
        this.addType("Float", "Float", 64, false, 0, 0);
    }

    public String name() {
        return this.moduleName;
    }

    public String stage() {
        return this.stageName;
    }

    public Int schema() {
        return SublangVocabulary.schemaVersion();
    }

    public Int revision() {
        return this.revisionNumber;
    }

    public Int entryFunction() {
        return this.entryFunctionId;
    }

    public Void setEntry(Int functionId) {
        this.entryFunctionId = functionId;
    }

    public Int voidType() {
        return 1;
    }

    public Int boolType() {
        return 2;
    }

    public Int intType() {
        return 3;
    }

    public Int floatType() {
        return 4;
    }

    public Int nextOperationId() {
        this.operationCounter = this.operationCounter + 1;
        return this.operationCounter;
    }

    public Int addSource(String name) {
        this.sourceNames.add(name + "");
        return this.sourceNames.length();
    }

    public Bool hasSource(Int id) {
        return id >= 1 && id <= this.sourceNames.length();
    }

    public String sourceNameAt(Int id) {
        return this.sourceNames.get(id - 1);
    }

    public Int sourceCount() {
        return this.sourceNames.length();
    }

    public Int addSpan(Int source, Int line, Int column, String origin) {
        Int spanId = this.spanList.length() + 1;
        SublangSourceSpan spanEntry = SublangSourceSpan(spanId, source, line, column, origin);
        this.spanList.add(spanEntry);
        return spanId;
    }

    public Bool hasSpan(Int id) {
        return id >= 1 && id <= this.spanList.length();
    }

    public SublangSourceSpan spanAt(Int id) {
        return this.spanList.get(id - 1);
    }

    public Int spanCount() {
        return this.spanList.length();
    }

    public Int addType(String kind, String name, Int width, Bool signed, Int target, Int span) {
        Int typeId = this.typeList.length() + 1;
        SublangType typeEntry = SublangType(typeId, kind, name, width, signed, target, span);
        this.typeList.add(typeEntry);
        return typeId;
    }

    public Bool hasType(Int id) {
        return id >= 1 && id <= this.typeList.length();
    }

    public SublangType typeAt(Int id) {
        return this.typeList.get(id - 1);
    }

    public Int typeCount() {
        return this.typeList.length();
    }

    // Non-mutating lookup of Ref<classTypeId>; returns 0 when it does not exist yet.
    public Int refTypeOrZero(Int classTypeId) {
        Int index = 1;
        while (index <= this.typeList.length()) {
            SublangType candidate = this.typeList.get(index - 1);
            if (candidate.isRef() && candidate.target() == classTypeId) {
                return candidate.id();
            }
            index = index + 1;
        }
        return 0;
    }

    // Interns Ref<classTypeId>, so equal references always share one type id.
    public Int refTypeFor(Int classTypeId) {
        Int existing = this.refTypeOrZero(classTypeId);
        if (existing != 0) {
            return existing;
        }
        String targetName = "?";
        Int targetSpan = 0;
        if (this.hasType(classTypeId)) {
            targetName = this.typeAt(classTypeId).name();
            targetSpan = this.typeAt(classTypeId).span();
        }
        return this.addType("Ref", "Ref<" + targetName + ">", 0, false, classTypeId, targetSpan);
    }

    public Int addField(Int owner, String name, Int typeId, Bool mutable, Int span) {
        Int fieldId = this.fieldList.length() + 1;
        SublangField fieldEntry = SublangField(fieldId, owner, name, typeId, mutable, span);
        this.fieldList.add(fieldEntry);
        if (this.hasType(owner)) {
            this.typeAt(owner).addField(fieldId);
        }
        return fieldId;
    }

    public Bool hasField(Int id) {
        return id >= 1 && id <= this.fieldList.length();
    }

    public SublangField fieldAt(Int id) {
        return this.fieldList.get(id - 1);
    }

    public Int fieldCount() {
        return this.fieldList.length();
    }

    // Failure actions are interned by name, e.g. "emerald.int_overflow".
    public Int failureId(String name) {
        Int index = 1;
        while (index <= this.failureNames.length()) {
            if (this.failureNames.get(index - 1) == name) {
                return index;
            }
            index = index + 1;
        }
        this.failureNames.add(name + "");
        return this.failureNames.length();
    }

    public Bool hasFailure(Int id) {
        return id >= 1 && id <= this.failureNames.length();
    }

    public String failureNameAt(Int id) {
        return this.failureNames.get(id - 1);
    }

    public Int failureCount() {
        return this.failureNames.length();
    }

    public Int addFunction(String name, Int returnType, Int methodOf, Int span) {
        Int functionId = this.functionList.length() + 1;
        SublangFunction fnEntry = SublangFunction(functionId, name, returnType, methodOf, span);
        this.functionList.add(fnEntry);
        return functionId;
    }

    public Bool hasFunction(Int id) {
        return id >= 1 && id <= this.functionList.length();
    }

    public SublangFunction functionAt(Int id) {
        return this.functionList.get(id - 1);
    }

    public Int functionCount() {
        return this.functionList.length();
    }
}
