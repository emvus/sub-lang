        List<String> valueMode = List();
        valueMode.add("value");
        List<String> singleBorrow = List();
        singleBorrow.add("borrow_read");
        List<String> pairBorrow = List();
        pairBorrow.add("borrow_read");
        pairBorrow.add("borrow_read");
        List<String> noModes = List();
        List<Int> noArgs = List();
        List<Int> number_args = List();
        number_args.add(builder.ops().constInt(1, span));
        Int number = builder.ops().callDirectOwned(lib.intFunction(), number_args, valueMode, scope, span);
        List<Int> word_args = List();
        word_args.add(builder.ops().constString("x", span));
        Int word = builder.ops().callDirectOwned(lib.textFunction(), word_args, valueMode, scope, span);
        List<Int> mixed_args = List();
        mixed_args.add(number);
        mixed_args.add(word);
        List<String> mixed_modes = List();
