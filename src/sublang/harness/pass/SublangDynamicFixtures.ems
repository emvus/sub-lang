    }

    // D5: closures as class Closure { code: Int, captured: owned Ref<Dyn> }. Closure A (code 1) captures int 40 and is called with 2: 42. Closure B (code 2) captures "ab" and is called with "cd": "cd" + "ab" = "cdab" (100). Expected 142.
    public static SublangModule d5() {
        SublangBuilder builder = SublangBuilder("dyn-d5");
        Int span = builder.syntheticSpan("dyn:d5");
        SublangDynamicLibrary lib = SublangDynamicLibrary(builder);
        Int closure = builder.classType("Closure", span);
        Int codeField = builder.classField(closure, "code", builder.intType(), true, span);
        Int capturedField = builder.classField(closure, "captured", lib.layout().dynRef(), true, span);
        Int makeClosure = builder.beginFunction("makeClosure", builder.refType(closure), 0, span);
        Int code = builder.addParam("code", builder.intType(), "value", false);
        Int captured = builder.addParam("captured", lib.layout().dynRef(), "owned", false);
        builder.beginBlock();
        Int mScope = builder.ops().scopeBegin(span);
        Int object = builder.ops().classNew(closure, mScope, span);
        builder.ops().fieldInit(object, codeField, code, span);
        builder.ops().fieldInitOwned(object, capturedField, captured, span);
        builder.ops().returnOwned(object, span);
        Int callClosure = builder.beginFunction("callClosure", lib.layout().dynRef(), 0, span);
        Int target = builder.addParam("target", builder.refType(closure), "borrow_read", false);
        Int argument = builder.addParam("argument", lib.layout().dynRef(), "borrow_read", false);
        builder.beginBlock();
        Int cScope = builder.ops().scopeBegin(span);
        Int codeValue = builder.ops().fieldRead(target, codeField, span);
        Int firstBody = builder.newBlock();
        Int restFirst = builder.newBlock();
        Int isOne = builder.ops().compare("eq", codeValue, builder.ops().constInt(1, span), span);
        List<Int> noTrue = List();
        List<Int> noFalse = List();
        builder.ops().condBranch(isOne, firstBody, noTrue, restFirst, noFalse, span);
        builder.enterBlock(firstBody);
        Int capturedFirst = builder.ops().fieldBorrow(target, capturedField, span);
        List<Int> firstArgs = List();
        firstArgs.add(capturedFirst);
        firstArgs.add(argument);
        List<String> firstModes = List();
        firstModes.add("borrow_read");
        firstModes.add("borrow_read");
        Int firstResult = builder.ops().callDirectOwned(lib.addFunction(), firstArgs, firstModes, cScope, span);
        builder.ops().returnOwned(firstResult, span);
        builder.enterBlock(restFirst);
        Int secondBody = builder.newBlock();
        Int restSecond = builder.newBlock();
        Int isTwo = builder.ops().compare("eq", codeValue, builder.ops().constInt(2, span), span);
        List<Int> noTrue2 = List();
        List<Int> noFalse2 = List();
        builder.ops().condBranch(isTwo, secondBody, noTrue2, restSecond, noFalse2, span);
        builder.enterBlock(secondBody);
        Int capturedSecond = builder.ops().fieldBorrow(target, capturedField, span);
        List<Int> secondArgs = List();
        secondArgs.add(argument);
        secondArgs.add(capturedSecond);
        List<String> secondModes = List();
        secondModes.add("borrow_read");
        secondModes.add("borrow_read");
        Int secondResult = builder.ops().callDirectOwned(lib.addFunction(), secondArgs, secondModes, cScope, span);
        builder.ops().returnOwned(secondResult, span);
        builder.enterBlock(restSecond);
        builder.ops().failWith(lib.layout().internalFailure(), span);
        Int entry = builder.beginFunction("main", builder.intType(), 0, span);
        builder.module().setEntry(entry);
        builder.beginBlock();
        Int scope = builder.ops().scopeBegin(span);
        List<String> valueMode = List();
        valueMode.add("value");
        List<String> singleBorrow = List();
        singleBorrow.add("borrow_read");
        List<String> pairBorrow = List();
        pairBorrow.add("borrow_read");
        pairBorrow.add("borrow_read");
        List<Int> forty_args = List();
        forty_args.add(builder.ops().constInt(40, span));
        Int forty = builder.ops().callDirectOwned(lib.intFunction(), forty_args, valueMode, scope, span);
        List<Int> closureA_args = List();
        closureA_args.add(builder.ops().constInt(1, span));
        closureA_args.add(forty);
        List<String> closureA_modes = List();
        closureA_modes.add("value");
        closureA_modes.add("owned");
        Int closureA = builder.ops().callDirectOwned(makeClosure, closureA_args, closureA_modes, scope, span);
        List<Int> two_args = List();
        two_args.add(builder.ops().constInt(2, span));
        Int two = builder.ops().callDirectOwned(lib.intFunction(), two_args, valueMode, scope, span);
        List<Int> resultA_args = List();
        resultA_args.add(closureA);
        resultA_args.add(two);
        List<String> resultA_modes = List();
        resultA_modes.add("borrow_read");
        resultA_modes.add("borrow_read");
        Int resultA = builder.ops().callDirectOwned(callClosure, resultA_args, resultA_modes, scope, span);
        List<Int> numberA_args = List();
        numberA_args.add(resultA);
        List<String> numberA_modes = List();
        numberA_modes.add("borrow_read");
        Int numberA = builder.ops().callDirect(lib.toIntFunction(), numberA_args, numberA_modes, span);
        List<Int> ab_args = List();
        ab_args.add(builder.ops().constString("ab", span));
        Int ab = builder.ops().callDirectOwned(lib.textFunction(), ab_args, valueMode, scope, span);
        List<Int> closureB_args = List();
        closureB_args.add(builder.ops().constInt(2, span));
        closureB_args.add(ab);
        List<String> closureB_modes = List();
        closureB_modes.add("value");
        closureB_modes.add("owned");
        Int closureB = builder.ops().callDirectOwned(makeClosure, closureB_args, closureB_modes, scope, span);
        List<Int> cd_args = List();
        cd_args.add(builder.ops().constString("cd", span));
        Int cd = builder.ops().callDirectOwned(lib.textFunction(), cd_args, valueMode, scope, span);
        List<Int> resultB_args = List();
        resultB_args.add(closureB);
        resultB_args.add(cd);
        List<String> resultB_modes = List();
        resultB_modes.add("borrow_read");
        resultB_modes.add("borrow_read");
        Int resultB = builder.ops().callDirectOwned(callClosure, resultB_args, resultB_modes, scope, span);
        List<Int> cdab_args = List();
        cdab_args.add(builder.ops().constString("cdab", span));
        Int cdab = builder.ops().callDirectOwned(lib.textFunction(), cdab_args, valueMode, scope, span);
        List<Int> same_args = List();
        same_args.add(resultB);
        same_args.add(cdab);
        List<String> same_modes = List();
        same_modes.add("borrow_read");
        same_modes.add("borrow_read");
        Int same = builder.ops().callDirect(lib.equalFunction(), same_args, same_modes, span);
        Int w_yes = builder.newBlock();
        Int w_no = builder.newBlock();
        Int w_join = builder.newBlock();
        List<Int> w_e1 = List();
        List<Int> w_e2 = List();
        builder.ops().condBranch(same, w_yes, w_e1, w_no, w_e2, span);
        builder.enterBlock(w_yes);
        List<Int> w_t = List();
        w_t.add(builder.ops().constInt(100, span));
        builder.ops().branchTo(w_join, w_t, span);
        builder.enterBlock(w_no);
        List<Int> w_f = List();
        w_f.add(builder.ops().constInt(0, span));
        builder.ops().branchTo(w_join, w_f, span);
        builder.enterBlock(w_join);
        Int w = builder.addBlockParam(builder.intType());
        Int answer = builder.ops().intBinary("int.add", numberA, w, "wrap", 0, span);
        builder.ops().scopeEnd(scope, span);
        builder.ops().returnValue(answer, span);
        return builder.module();
    }

    // D6: a function returns its borrow_read parameter as if it were owned. The backend gate must reject it with "borrowed reference cannot be returned as owned".
    public static SublangModule d6() {
        SublangBuilder builder = SublangBuilder("dyn-d6");
        Int span = builder.syntheticSpan("dyn:d6");
        SublangDynamicLibrary lib = SublangDynamicLibrary(builder);
        Int leak = builder.beginFunction("leakCapture", lib.layout().dynRef(), 0, span);
        Int borrowed = builder.addParam("value", lib.layout().dynRef(), "borrow_read", false);
        builder.beginBlock();
        builder.ops().returnOwned(borrowed, span);
        Int entry = builder.beginFunction("main", builder.intType(), 0, span);
        builder.module().setEntry(entry);
        builder.beginBlock();
        builder.ops().returnValue(builder.ops().constInt(0, span), span);
        return builder.module();
    }

}
