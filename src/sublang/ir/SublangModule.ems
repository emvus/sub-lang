namespace sublang::ir;

use sublang::body::SublangFunction;
use sublang::ir::SublangAliasTable;
use sublang::ir::SublangSemanticTable;
use sublang::ir::SublangTypeTable;
use sublang::model::SublangSourceSpan;
use sublang::vocabulary::SublangVocabulary;

// One revision of a module. The module owns the source, span and function tables and gives
// access to the type, semantic and alias tables. freeze() seals the revision and every table at
// once, so a later pass can rely on the revision not changing underneath it. Mutations that
// arrive after the freeze are refused and counted, never applied.
public class SublangModule {
    private String moduleName;
    private String stageName;
    private Int revisionNumber;
    private Int entryFunctionId;
    private Int operationCounter;
    private Bool frozenFlag;
    private Int refusalCounter;
    private List<String> sourceNames;
    private List<SublangSourceSpan> spanList;
    private List<SublangFunction> functionList;
    private SublangTypeTable typeTable;
    private SublangSemanticTable semanticTable;
    private SublangAliasTable aliasTable;

    public SublangModule(String name) {
        this.moduleName = name + "";
        this.stageName = SublangVocabulary.stageHigh();
        this.revisionNumber = 1;
        this.entryFunctionId = 0;
        this.operationCounter = 0;
        this.frozenFlag = false;
        this.refusalCounter = 0;
        this.sourceNames = List();
        this.spanList = List();
        this.functionList = List();
        this.typeTable = SublangTypeTable();
        this.semanticTable = SublangSemanticTable();
        this.aliasTable = SublangAliasTable(this.revisionNumber);
    }

    public String name() {
        return this.moduleName;
    }

    public String stage() {
        return this.stageName;
    }

    public Int schema() {
        return SublangVocabulary.schemaVersion();
    }

    public Int revision() {
        return this.revisionNumber;
    }

    public Int entryFunction() {
        return this.entryFunctionId;
    }

    public Void setEntry(Int functionId) {
        if (this.frozenFlag) {
            this.refuse();
            return;
        }
        this.entryFunctionId = functionId;
    }

    public SublangTypeTable types() {
        return this.typeTable;
    }

    public SublangSemanticTable semantics() {
        return this.semanticTable;
    }

    public SublangAliasTable aliases() {
        return this.aliasTable;
    }

    public Bool isFrozen() {
        return this.frozenFlag;
    }

    // Refused mutations of the module itself and of all of its tables.
    public Int refusalCount() {
        return this.refusalCounter + this.typeTable.refusalCount() + this.semanticTable.refusalCount() + this.aliasTable.refusalCount();
    }

    public Void refuse() {
        this.refusalCounter = this.refusalCounter + 1;
    }

    // Seals this revision: the module, its tables and every function, block and operation inside
    // it refuse further mutation. Analyses must refer to a frozen revision.
    public Void freeze() {
        this.frozenFlag = true;
        Int index = 1;
        while (index <= this.functionList.length()) {
            this.functionList.get(index - 1).freeze();
            index = index + 1;
        }
        this.typeTable.freeze();
        this.semanticTable.freeze();
        this.aliasTable.freeze();
    }

    public Int nextOperationId() {
        if (this.frozenFlag) {
            this.refuse();
            return 0;
        }
        this.operationCounter = this.operationCounter + 1;
        return this.operationCounter;
    }

    public Int addSource(String name) {
        if (this.frozenFlag) {
            this.refuse();
            return 0;
        }
        this.sourceNames.add(name + "");
        return this.sourceNames.length();
    }

    public Bool hasSource(Int id) {
        return id >= 1 && id <= this.sourceNames.length();
    }

    public String sourceNameAt(Int id) {
        return this.sourceNames.get(id - 1);
    }

    public Int sourceCount() {
        return this.sourceNames.length();
    }

    public Int addSpan(Int source, Int line, Int column, String origin) {
        if (this.frozenFlag) {
            this.refuse();
            return 0;
        }
        Int spanId = this.spanList.length() + 1;
        SublangSourceSpan spanEntry = SublangSourceSpan(spanId, source, line, column, origin);
        this.spanList.add(spanEntry);
        return spanId;
    }

    public Bool hasSpan(Int id) {
        return id >= 1 && id <= this.spanList.length();
    }

    public SublangSourceSpan spanAt(Int id) {
        return this.spanList.get(id - 1);
    }

    public Int spanCount() {
        return this.spanList.length();
    }

    public Int addFunction(String name, Int returnType, Int methodOf, Int span) {
        if (this.frozenFlag) {
            this.refuse();
            return 0;
        }
        Int functionId = this.functionList.length() + 1;
        SublangFunction fnEntry = SublangFunction(functionId, name, returnType, methodOf, span);
        this.functionList.add(fnEntry);
        return functionId;
    }

    public Bool hasFunction(Int id) {
        return id >= 1 && id <= this.functionList.length();
    }

    public SublangFunction functionAt(Int id) {
        return this.functionList.get(id - 1);
    }

    public Int functionCount() {
        return this.functionList.length();
    }
}
