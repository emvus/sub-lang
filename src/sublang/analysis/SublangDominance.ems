namespace sublang::analysis;

use sublang::ir::SublangBlock;
use sublang::ir::SublangFunction;
use sublang::ir::SublangOperation;

// Reachability and dominators for one function, computed by iteration over
// the control-flow graph given by the terminators. Block 1 is the entry.
// dominatorFlags is a flat n*n table: entry (block, dominator) sits at
// (block - 1) * n + (dominator - 1).
public class SublangDominance {
    private SublangFunction function;
    private Int blockTotal;
    private List<Bool> reachableFlags;
    private List<Bool> dominatorFlags;

    public SublangDominance(SublangFunction fnEntry) {
        this.function = fnEntry;
        this.blockTotal = fnEntry.blockCount();
        this.reachableFlags = List();
        this.dominatorFlags = List();
        this.computeReachability();
        this.computeDominators();
    }

    public Bool isReachable(Int blockId) {
        if (!this.function.hasBlock(blockId)) {
            return false;
        }
        return this.reachableFlags.get(blockId - 1);
    }

    public Bool dominates(Int dominator, Int blockId) {
        if (!this.isReachable(dominator)) {
            return false;
        }
        if (!this.isReachable(blockId)) {
            return false;
        }
        return this.dominatorFlags.get((blockId - 1) * this.blockTotal + (dominator - 1));
    }

    // Successors that exist in the function; invalid targets are reported by the verifier.
    public List<Int> successorsOf(Int blockId) {
        List<Int> result = List();
        SublangBlock blockEntry = this.function.blockAt(blockId);
        Int count = blockEntry.operationCount();
        if (count == 0) {
            return result;
        }
        SublangOperation last = blockEntry.operationAt(count - 1);
        if (last.opcode() == "branch" || last.opcode() == "cond_branch") {
            Int index = 0;
            while (index < last.targets().length()) {
                Int target = last.targets().get(index);
                if (this.function.hasBlock(target)) {
                    result.add(target);
                }
                index = index + 1;
            }
        }
        return result;
    }

    public Bool isPredecessor(Int predecessor, Int blockId) {
        List<Int> succ = this.successorsOf(predecessor);
        Int index = 0;
        while (index < succ.length()) {
            if (succ.get(index) == blockId) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    private Void computeReachability() {
        Int index = 0;
        while (index < this.blockTotal) {
            this.reachableFlags.add(false);
            index = index + 1;
        }
        if (this.blockTotal == 0) {
            return;
        }
        this.reachableFlags.set(0, true);
        List<Int> stack = List();
        stack.add(1);
        while (stack.length() > 0) {
            Int current = stack.removeAt(stack.length() - 1);
            List<Int> next = this.successorsOf(current);
            Int k = 0;
            while (k < next.length()) {
                Int succ = next.get(k);
                if (!this.reachableFlags.get(succ - 1)) {
                    this.reachableFlags.set(succ - 1, true);
                    stack.add(succ);
                }
                k = k + 1;
            }
        }
    }

    // Dom(entry) = {entry}; Dom(b) = {b} union intersection of Dom(p) over reachable predecessors p.
    private Void computeDominators() {
        Int n = this.blockTotal;
        Int slot = 0;
        while (slot < n * n) {
            this.dominatorFlags.add(false);
            slot = slot + 1;
        }
        Int b = 2;
        while (b <= n) {
            Int a = 1;
            while (a <= n) {
                this.dominatorFlags.set((b - 1) * n + (a - 1), true);
                a = a + 1;
            }
            b = b + 1;
        }
        if (n > 0) {
            this.dominatorFlags.set(0, true);
        }
        Bool changed = true;
        while (changed) {
            changed = false;
            b = 2;
            while (b <= n) {
                if (this.reachableFlags.get(b - 1)) {
                    Int a = 1;
                    while (a <= n) {
                        Bool value = true;
                        if (a != b) {
                            Bool sawPredecessor = false;
                            Int p = 1;
                            while (p <= n) {
                                if (this.reachableFlags.get(p - 1) && this.isPredecessor(p, b)) {
                                    sawPredecessor = true;
                                    if (!this.dominatorFlags.get((p - 1) * n + (a - 1))) {
                                        value = false;
                                    }
                                }
                                p = p + 1;
                            }
                            if (!sawPredecessor) {
                                value = false;
                            }
                        }
                        Int target = (b - 1) * n + (a - 1);
                        if (this.dominatorFlags.get(target) != value) {
                            this.dominatorFlags.set(target, value);
                            changed = true;
                        }
                        a = a + 1;
                    }
                }
                b = b + 1;
            }
        }
    }
}
