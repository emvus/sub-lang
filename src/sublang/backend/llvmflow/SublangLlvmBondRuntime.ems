namespace sublang::backend::llvmflow;

// Only shared graphs pay for a sidecar. External handle counts are separate from
// graph edges: an unrooted strongly connected graph is reclaimable as a whole.
// The collector is synchronous and module-local; the accepted IR has no threads,
// finalizers or arbitrary foreign pointers into this graph.
public class SublangLlvmBondRuntime {
    public static String definitions() {
        String text = "%sublang.bond.meta = type { ptr, ptr, i64, i1, ptr, ptr, ptr, i64, i64, ptr, i1, i1, i1, ptr }\n%sublang.bond.root = type { ptr, ptr, ptr }\n@sublang.bond.nodes = internal global ptr null\n@sublang.bond.work = internal global ptr null\n@sublang.bond.dirty = internal global i1 false\n";
        return text + SublangLlvmBondRuntime.allocate() + SublangLlvmBondRuntime.counts() + SublangLlvmBondRuntime.edges() + SublangLlvmBondRuntime.roots();
    }

    private static String allocate() {
        return "define internal ptr @sublang.bond.allocate(i64 %size, ptr %trace) {\nentry:\n  %large = icmp ugt i64 %size, -17\n  br i1 %large, label %bad, label %ok\nbad:\n  call void @abort()\n  unreachable\nok:\n  %total = add i64 %size, 16\n  %header = call ptr @sublang.allocate(i64 %total)\n  %meta = call ptr @sublang.allocate(i64 96)\n  store %sublang.bond.meta zeroinitializer, ptr %meta\n  store ptr %meta, ptr %header\n  %payload = getelementptr i8, ptr %header, i64 16\n  %roots = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 2\n  store i64 1, ptr %roots\n  %callback = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 4\n  store ptr %trace, ptr %callback\n  %object = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 5\n  store ptr %payload, ptr %object\n  %head = load ptr, ptr @sublang.bond.nodes\n  store ptr %head, ptr %meta\n  store ptr %meta, ptr @sublang.bond.nodes\n  %present = icmp ne ptr %head, null\n  br i1 %present, label %link, label %done\nlink:\n  %previous = getelementptr %sublang.bond.meta, ptr %head, i32 0, i32 1\n  store ptr %meta, ptr %previous\n  br label %done\ndone:\n  ret ptr %payload\n}\n";
    }

    private static String counts() {
        String text = "define internal ptr @sublang.bond.meta(ptr %payload) {\nentry:\n  %null = icmp eq ptr %payload, null\n  br i1 %null, label %bad, label %ok\nbad:\n  call void @abort()\n  unreachable\nok:\n  %header = getelementptr i8, ptr %payload, i64 -16\n  %meta = load ptr, ptr %header\n  ret ptr %meta\n}\n";
        text = text + "define internal void @sublang.bond.retain(ptr %payload) {\nentry:\n  %meta = call ptr @sublang.bond.meta(ptr %payload)\n  %slot = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 2\n  %old = load i64, ptr %slot\n  %full = icmp eq i64 %old, -1\n  br i1 %full, label %bad, label %ok\nbad:\n  call void @abort()\n  unreachable\nok:\n  %next = add i64 %old, 1\n  store i64 %next, ptr %slot\n  call void @sublang.bond.cache.adjust(ptr %payload, i64 1)\n  ret void\n}\n";
        return text + "define internal void @sublang.bond.unroot(ptr %payload) {\nentry:\n  %meta = call ptr @sublang.bond.meta(ptr %payload)\n  %slot = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 2\n  %old = load i64, ptr %slot\n  %zero = icmp eq i64 %old, 0\n  br i1 %zero, label %bad, label %ok\nbad:\n  call void @abort()\n  unreachable\nok:\n  %next = sub i64 %old, 1\n  store i64 %next, ptr %slot\n  call void @sublang.bond.cache.adjust(ptr %payload, i64 -1)\n  %candidate = icmp eq i64 %next, 0\n  call void @sublang.bond.candidate(ptr %payload, i1 %candidate)\n  ret void\n}\n";
    }


    private static String edges() {
        String visitor = "define internal void @sublang.bond.edge.visit(ptr %slot, i1 %remove) {\nentry:\n  %child = load ptr, ptr %slot\n  br i1 %remove, label %drop, label %mark\ndrop:\n  call void @sublang.bond.edge.count(ptr %child, i1 false)\n  store ptr null, ptr %slot\n  ret void\nmark:\n  %phase = load i32, ptr @sublang.bond.phase\n  call void @sublang.bond.trial.edge(ptr %child, i32 %phase)\n  ret void\n}\n";
        String text = "define internal void @sublang.bond.edge.count(ptr %payload, i1 %add) {\nentry:\n  %null = icmp eq ptr %payload, null\n  br i1 %null, label %done, label %count\ncount:\n  %meta = call ptr @sublang.bond.meta(ptr %payload)\n  %slot = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 7\n  %old = load i64, ptr %slot\n  %limit = select i1 %add, i64 -1, i64 0\n  %invalid = icmp eq i64 %old, %limit\n  br i1 %invalid, label %bad, label %update\nbad:\n  call void @abort()\n  unreachable\nupdate:\n  %delta = select i1 %add, i64 1, i64 -1\n  %next = add i64 %old, %delta\n  store i64 %next, ptr %slot\n  br label %done\ndone:\n  ret void\n}\n";
        text = text + "define internal void @sublang.bond.edge.set(ptr %slot, ptr %child) {\nentry:\n  %old = load ptr, ptr %slot\n  %same = icmp eq ptr %old, %child\n  br i1 %same, label %done, label %update\nupdate:\n  call void @sublang.bond.graph.changed()\n  call void @sublang.bond.edge.count(ptr %child, i1 true)\n  store ptr %child, ptr %slot\n  call void @sublang.bond.edge.count(ptr %old, i1 false)\n  call void @sublang.bond.candidate(ptr %old, i1 true)\n  call void @sublang.bond.collect()\n  br label %done\ndone:\n  ret void\n}\n";
        return visitor + text + "define internal void @sublang.bond.collect() {\nentry:\n  call void @sublang.bond.trial.collect()\n  ret void\n}\n";
    }


    private static String roots() {
        String text = "define internal ptr @sublang.bond.root.take(ptr %root) {\nentry:\n  %ps = getelementptr %sublang.bond.root, ptr %root, i32 0, i32 2\n  %payload = load ptr, ptr %ps\n  %empty = icmp eq ptr %payload, null\n  br i1 %empty, label %done, label %unlink\nunlink:\n  %bs = getelementptr %sublang.bond.root, ptr %root, i32 0, i32 1\n  %back = load ptr, ptr %bs\n  %next = load ptr, ptr %root\n  store ptr %next, ptr %back\n  %present = icmp ne ptr %next, null\n  br i1 %present, label %fix, label %reset\nfix:\n  %next.back = getelementptr %sublang.bond.root, ptr %next, i32 0, i32 1\n  store ptr %back, ptr %next.back\n  br label %reset\nreset:\n  store %sublang.bond.root zeroinitializer, ptr %root\n  br label %done\ndone:\n  ret ptr %payload\n}\n";
        text = text + "define internal void @sublang.bond.root.add(ptr %scope, ptr %root, ptr %payload) {\nentry:\n  %old = call ptr @sublang.bond.root.take(ptr %root)\n  %had.old = icmp ne ptr %old, null\n  br i1 %had.old, label %release, label %attach\nrelease:\n  call void @sublang.bond.unroot(ptr %old)\n  br label %attach\nattach:\n  %previous = load ptr, ptr %scope\n  store ptr %previous, ptr %root\n  %back = getelementptr %sublang.bond.root, ptr %root, i32 0, i32 1\n  store ptr %scope, ptr %back\n  %ps = getelementptr %sublang.bond.root, ptr %root, i32 0, i32 2\n  store ptr %payload, ptr %ps\n  store ptr %root, ptr %scope\n  %nonempty = icmp ne ptr %previous, null\n  br i1 %nonempty, label %fix, label %done\nfix:\n  %previous.back = getelementptr %sublang.bond.root, ptr %previous, i32 0, i32 1\n  store ptr %root, ptr %previous.back\n  br label %done\ndone:\n  br i1 %had.old, label %collect, label %exit\ncollect:\n  call void @sublang.bond.collect()\n  br label %exit\nexit:\n  ret void\n}\n";
        return text + "define internal void @sublang.bond.scope.end(ptr %scope) {\nentry:\n  br label %loop\nloop:\n  %root = load ptr, ptr %scope\n  %empty = icmp eq ptr %root, null\n  br i1 %empty, label %done, label %release\nrelease:\n  %payload = call ptr @sublang.bond.root.take(ptr %root)\n  call void @sublang.bond.unroot(ptr %payload)\n  br label %loop\ndone:\n  call void @sublang.bond.collect()\n  ret void\n}\n";
    }
}
