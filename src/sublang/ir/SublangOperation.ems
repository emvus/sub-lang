namespace sublang::ir;

use sublang::ir::SublangVocabulary;

// One High IR operation. Only the attributes relevant to its opcode are set:
// ref() is a type, field, function, scope or failure id depending on the
// opcode (see SublangVocabulary.refMeaning). Operand passing modes are parallel to
// the operand list.
public class SublangOperation {
    private Int opIdValue;
    private String opcodeName;
    private Int spanIdValue;
    private List<Int> operandIds;
    private List<String> operandModes;
    private Int resultValueId;
    private Int resultTypeId;
    private Int refId;
    private Int scopeIdValue;
    private String overflowMode;
    private String predicateName;
    private String fpModeName;
    private List<Int> targetBlockIds;
    private Int trueArgCount;
    private Int constIntValue;
    private Bool constBoolValue;
    private Float constFloatValue;

    public SublangOperation(Int id, String opcode, Int span) {
        this.opIdValue = id;
        this.opcodeName = opcode + "";
        this.spanIdValue = span;
        this.operandIds = List();
        this.operandModes = List();
        this.resultValueId = 0;
        this.resultTypeId = 0;
        this.refId = 0;
        this.scopeIdValue = 0;
        this.overflowMode = "";
        this.predicateName = "";
        this.fpModeName = "";
        this.targetBlockIds = List();
        this.trueArgCount = 0;
        this.constIntValue = 0;
        this.constBoolValue = false;
        this.constFloatValue = 0.0;
    }

    public Int id() {
        return this.opIdValue;
    }

    public String opcode() {
        return this.opcodeName;
    }

    public Int span() {
        return this.spanIdValue;
    }

    public List<Int> operands() {
        return this.operandIds;
    }

    public Int operandCount() {
        return this.operandIds.length();
    }

    public Int operandAt(Int index) {
        return this.operandIds.get(index);
    }

    public Int modeCount() {
        return this.operandModes.length();
    }

    public String modeAt(Int index) {
        return this.operandModes.get(index);
    }

    public Bool hasResult() {
        return this.resultValueId != 0;
    }

    public Int resultValue() {
        return this.resultValueId;
    }

    public Int resultType() {
        return this.resultTypeId;
    }

    public Int ref() {
        return this.refId;
    }

    public Int scope() {
        return this.scopeIdValue;
    }

    public String overflow() {
        return this.overflowMode;
    }

    public String predicate() {
        return this.predicateName;
    }

    public String fpMode() {
        return this.fpModeName;
    }

    public List<Int> targets() {
        return this.targetBlockIds;
    }

    public Int trueArgs() {
        return this.trueArgCount;
    }

    public Int constInt() {
        return this.constIntValue;
    }

    public Bool constBool() {
        return this.constBoolValue;
    }

    public Float constFloat() {
        return this.constFloatValue;
    }

    public Bool isTerminator() {
        return SublangVocabulary.isTerminator(this.opcodeName);
    }

    public Void setOperands(List<Int> ids, List<String> modes) {
        this.operandIds = ids;
        this.operandModes = modes;
    }

    public Void setResult(Int valueId, Int typeId) {
        this.resultValueId = valueId;
        this.resultTypeId = typeId;
    }

    public Void setRef(Int value) {
        this.refId = value;
    }

    public Void setScope(Int value) {
        this.scopeIdValue = value;
    }

    public Void setOverflow(String mode) {
        this.overflowMode = mode + "";
    }

    public Void setPredicate(String predicate) {
        this.predicateName = predicate + "";
    }

    public Void setFpMode(String mode) {
        this.fpModeName = mode + "";
    }

    public Void setTargets(List<Int> blocks, Int argCount) {
        this.targetBlockIds = blocks;
        this.trueArgCount = argCount;
    }

    public Void setConstInt(Int value) {
        this.constIntValue = value;
    }

    public Void setConstBool(Bool value) {
        this.constBoolValue = value;
    }

    public Void setConstFloat(Float value) {
        this.constFloatValue = value;
    }
}
