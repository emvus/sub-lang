use sublang::harness::SublangHarnessAccepted;
use sublang::harness::SublangHarnessRejected;
use sublang::harness::SublangHarnessSemantics;
use sublang::harness::SublangHarnessTally;
use sublang::harness::SublangHarnessBoundaries;
use Std::Process::Process;

// Standalone check for the Sublang High IR core (Auftrag A, A.0 and A.1). It is not part
// of the production compiler: nothing in Main.ems imports it. Build and run it only in
// the capped sandbox.
main() {
    SublangHarnessTally tally = SublangHarnessTally();
    tally.record(SublangHarnessAccepted.validModuleAccepted());
    tally.record(SublangHarnessRejected.typeErrorRejected());
    tally.record(SublangHarnessRejected.dominanceRejected());
    tally.record(SublangHarnessRejected.missingOverflowRejected());
    tally.record(SublangHarnessSemantics.invalidProfileRejected());
    tally.record(SublangHarnessSemantics.unsupportedProfileRuleRejected());
    tally.record(SublangHarnessAccepted.floatBitsAndPredicatesAccepted());
    tally.record(SublangHarnessRejected.floatGenericPredicateRejected());
    tally.record(SublangHarnessRejected.externalCallRejected());
    tally.record(SublangHarnessAccepted.freezeRefusesMutation());
    tally.record(SublangHarnessSemantics.incompleteEffectSummaryRejected());
    tally.record(SublangHarnessSemantics.incompleteFailureActionRejected());
    tally.record(SublangHarnessAccepted.aliasFactsAnswerConservatively());
    tally.record(SublangHarnessSemantics.aliasNoAliasWithoutOriginRejected());
    tally.record(SublangHarnessRejected.undefinedBlockParamTypeRejected());
    tally.record(SublangHarnessRejected.unknownPassingModeRejected());
    tally.record(SublangHarnessRejected.unknownRecordFieldRejected());
    tally.record(SublangHarnessRejected.unsupportedWidthRejected());
    tally.record(SublangHarnessRejected.bareClassParamRejected());
    tally.record(SublangHarnessAccepted.reverifyAfterRepair());
    tally.record(SublangHarnessAccepted.resultIsolatedFromListChanges());
    tally.record(SublangHarnessSemantics.unsupportedFailureRecordsRejected());
    tally.record(SublangHarnessSemantics.danglingReferencesRejected());
    tally.record(SublangHarnessSemantics.fpModeProfileMismatchRejected());
    tally.record(SublangHarnessAccepted.optionsValidated());
    tally.record(SublangHarnessBoundaries.freezeSnapshots());
    tally.record(SublangHarnessBoundaries.failureSignatureRejected());
    tally.record(SublangHarnessBoundaries.evidenceBoundaries());
    if (tally.failures() == 0) {
        println("Sublang harness: all " + tally.total().toString() + " cases passed");
        return;
    }
    println("Sublang harness: " + tally.failures().toString() + " of " + tally.total().toString() + " case(s) failed");
    Process.exit(1);
}
