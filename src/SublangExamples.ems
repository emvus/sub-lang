use sublang::analysis::SublangVerification;
use sublang::analysis::SublangVerifier;
use sublang::ir::SublangBuilder;
use sublang::dump::SublangDump;
use sublang::ir::SublangModule;
use Std::Process::Process;

// Standalone examples of the CURRENT API. Not imported by production Main.
// Build/run only through scripts/sublang-examples-sandbox.sh (6 GB, no swap).
public class SublangExamples {
    public static List<Int> one(Int value) {
        List<Int> values = List();
        values.add(value);
        return values;
    }

    public static List<Int> two(Int left, Int right) {
        List<Int> values = List();
        values.add(left);
        values.add(right);
        return values;
    }

    // Semantic result: 42.
    public static SublangModule arithmetic() {
        SublangBuilder builder = SublangBuilder("01-arithmetic");
        Int span = builder.syntheticSpan("example:arithmetic");
        Int failure = builder.failure("example.integer_failure");
        Int add = builder.beginFunction("add", builder.intType(), 0, span);
        Int left = builder.addParam("x", builder.intType(), "value", false);
        Int right = builder.addParam("y", builder.intType(), "value", false);
        builder.beginBlock();
        Int sum = builder.ops().intBinary("int.add", left, right, "trap", failure, span);
        builder.ops().returnValue(sum, span);
        Int mainFn = builder.beginFunction("main", builder.intType(), 0, span);
        builder.beginBlock();
        Int leftArgument = builder.ops().constInt(20, span);
        Int rightArgument = builder.ops().constInt(22, span);
        List<String> modes = List();
        modes.add("value");
        modes.add("value");
        Int result = builder.ops().callDirect(add, SublangExamples.two(leftArgument, rightArgument), modes, span);
        builder.ops().returnValue(result, span);
        builder.module().setEntry(mainFn);
        return builder.module();
    }

    // max(a,b), merged through a block parameter instead of mutable locals.
    public static SublangModule branch() {
        SublangBuilder builder = SublangBuilder("02-branch");
        Int span = builder.syntheticSpan("example:branch");
        Int fn = builder.beginFunction("max", builder.intType(), 0, span);
        Int left = builder.addParam("a", builder.intType(), "value", false);
        Int right = builder.addParam("b", builder.intType(), "value", false);
        builder.beginBlock();
        Int yes = builder.newBlock();
        Int no = builder.newBlock();
        Int merge = builder.newBlock();
        Int condition = builder.ops().compare("gt", left, right, span);
        List<Int> empty = List();
        builder.ops().condBranch(condition, yes, empty, no, empty, span);
        builder.enterBlock(yes);
        builder.ops().branchTo(merge, SublangExamples.one(left), span);
        builder.enterBlock(no);
        builder.ops().branchTo(merge, SublangExamples.one(right), span);
        builder.enterBlock(merge);
        Int selected = builder.addBlockParam(builder.intType());
        builder.ops().returnValue(selected, span);
        // Library module: entry=0 is intentional.
        return builder.module();
    }

    // sum(0 .. n-1), loop-carried i and total are SSA block parameters.
    public static SublangModule loop() {
        SublangBuilder builder = SublangBuilder("03-loop");
        Int span = builder.syntheticSpan("example:loop");
        Int failure = builder.failure("example.integer_failure");
        builder.beginFunction("sumBelow", builder.intType(), 0, span);
        Int limit = builder.addParam("n", builder.intType(), "value", false);
        builder.beginBlock();
        Int header = builder.newBlock();
        Int body = builder.newBlock();
        Int exit = builder.newBlock();
        Int zero = builder.ops().constInt(0, span);
        Int step = builder.ops().constInt(1, span);
        builder.ops().branchTo(header, SublangExamples.two(zero, zero), span);
        builder.enterBlock(header);
        Int counter = builder.addBlockParam(builder.intType());
        Int total = builder.addBlockParam(builder.intType());
        Int more = builder.ops().compare("lt", counter, limit, span);
        List<Int> empty = List();
        builder.ops().condBranch(more, body, empty, exit, SublangExamples.one(total), span);
        builder.enterBlock(body);
        Int nextTotal = builder.ops().intBinary("int.add", total, counter, "trap", failure, span);
        Int nextCounter = builder.ops().intBinary("int.add", counter, step, "trap", failure, span);
        builder.ops().branchTo(header, SublangExamples.two(nextCounter, nextTotal), span);
        builder.enterBlock(exit);
        Int result = builder.addBlockParam(builder.intType());
        builder.ops().returnValue(result, span);
        return builder.module();
    }

    // Value semantics: record.with returns a NEW Pair; original.x remains 20.
    public static SublangModule record() {
        SublangBuilder builder = SublangBuilder("04-record");
        Int span = builder.syntheticSpan("example:record");
        Int failure = builder.failure("example.integer_failure");
        Int pair = builder.recordType("Pair", span);
        Int fieldX = builder.recordField(pair, "x", builder.intType(), span);
        Int fieldY = builder.recordField(pair, "y", builder.intType(), span);
        Int fn = builder.beginFunction("main", builder.intType(), 0, span);
        builder.beginBlock();
        Int initialX = builder.ops().constInt(20, span);
        Int initialY = builder.ops().constInt(22, span);
        Int original = builder.ops().recordMake(pair, SublangExamples.two(initialX, initialY), span);
        Int replacement = builder.ops().constInt(21, span);
        Int updated = builder.ops().recordWith(original, fieldX, replacement, span);
        Int updatedX = builder.ops().recordGet(updated, fieldX, span);
        Int originalY = builder.ops().recordGet(original, fieldY, span);
        Int result = builder.ops().intBinary("int.add", updatedX, originalY, "trap", failure, span);
        builder.ops().returnValue(result, span);
        builder.module().setEntry(fn);
        return builder.module();
    }

    public static SublangModule object() {
        SublangBuilder builder = SublangBuilder("05-object");
        Int span = builder.syntheticSpan("example:object");
        Int counter = builder.classType("Counter", span);
        Int field = builder.classField(counter, "value", builder.intType(), true, span);
        Int ref = builder.refType(counter);
        Int read = builder.beginFunction("Counter.read", builder.intType(), counter, span);
        Int self = builder.addParam("self", ref, "borrow_read", true);
        builder.beginBlock();
        Int observed = builder.ops().fieldRead(self, field, span);
        builder.ops().returnValue(observed, span);
        Int fn = builder.beginFunction("main", builder.intType(), 0, span);
        builder.beginBlock();
        Int scope = builder.ops().scopeBegin(span);
        Int instance = builder.ops().classNew(counter, scope, span);
        Int before = builder.ops().constInt(1, span);
        builder.ops().fieldInit(instance, field, before, span);
        Int after = builder.ops().constInt(42, span);
        builder.ops().fieldWrite(instance, field, after, span);
        List<String> modes = List();
        modes.add("borrow_read");
        Int result = builder.ops().callDirect(read, SublangExamples.one(instance), modes, span);
        builder.ops().scopeEnd(scope, span);
        builder.ops().returnValue(result, span);
        builder.module().setEntry(fn);
        return builder.module();
    }

    // Float parameters avoid the current lossy constant-dump representation.
    // For (6.0,2.0), ((a*b+a)-a)/b = 6.0 with explicit rne on every op.
    public static SublangModule floating() {
        SublangBuilder builder = SublangBuilder("06-float");
        Int span = builder.syntheticSpan("example:float");
        builder.beginFunction("calculate", builder.floatType(), 0, span);
        Int left = builder.addParam("a", builder.floatType(), "value", false);
        Int right = builder.addParam("b", builder.floatType(), "value", false);
        builder.beginBlock();
        Int product = builder.ops().floatBinary("float.mul", left, right, "rne", span);
        Int sum = builder.ops().floatBinary("float.add", product, left, "rne", span);
        Int difference = builder.ops().floatBinary("float.sub", sum, left, "rne", span);
        Int result = builder.ops().floatBinary("float.div", difference, right, "rne", span);
        builder.ops().returnValue(result, span);
        return builder.module();
    }

    // Failure is a terminator; a failure block does not need a return.
    public static SublangModule failure() {
        SublangBuilder builder = SublangBuilder("07-failure");
        Int span = builder.syntheticSpan("example:failure");
        Int invalidInput = builder.failure("example.invalid_input");
        builder.beginFunction("requireNonNegative", builder.intType(), 0, span);
        Int input = builder.addParam("x", builder.intType(), "value", false);
        builder.beginBlock();
        Int bad = builder.newBlock();
        Int good = builder.newBlock();
        Int zero = builder.ops().constInt(0, span);
        Int negative = builder.ops().compare("lt", input, zero, span);
        List<Int> empty = List();
        builder.ops().condBranch(negative, bad, empty, good, empty, span);
        builder.enterBlock(bad);
        builder.ops().failWith(invalidInput, span);
        builder.enterBlock(good);
        builder.ops().returnValue(input, span);
        return builder.module();
    }

    public static String yesNo(Bool value) {
        if (value) {
            return "yes";
        }
        return "no";
    }

    public static Void show(SublangModule module) {
        SublangVerifier verifier = SublangVerifier(module);
        SublangVerification verdict = verifier.verify();
        if (!verdict.structurallyValid()) {
            println("INVALID " + module.name());
            Int i = 0;
            while (i < verdict.diagnostics().length()) {
                println(verdict.diagnostics().get(i).message());
                i = i + 1;
            }
            Process.exit(1);
        }
        println("=== Sublang " + module.name() + " ===");
        println(SublangDump.render(module));
        println("=== END Sublang ===");
        println("structure=" + verdict.structureStatus() + " semantics=" + verdict.semanticsStatus() + " effects=" + verdict.effectStatus() + " memory=" + verdict.memoryStatus() + " codegenReady=" + SublangExamples.yesNo(verdict.codegenReady()));
    }
}

main() {
    SublangExamples.show(SublangExamples.arithmetic());
    SublangExamples.show(SublangExamples.branch());
    SublangExamples.show(SublangExamples.loop());
    SublangExamples.show(SublangExamples.record());
    SublangExamples.show(SublangExamples.object());
    SublangExamples.show(SublangExamples.floating());
    SublangExamples.show(SublangExamples.failure());
}
