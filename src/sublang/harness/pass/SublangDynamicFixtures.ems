namespace sublang::harness::pass;

use sublang::ir::SublangBuilder;
use sublang::ir::SublangModule;
use sublang::dynamic::SublangDynamicLibrary;

// Acceptance programs for the Dyn library (docs/Sublang_Dynamic_Library.md). Each module calls the
// library and returns an Int, except D6, which must be rejected by the backend gate. The expected
// values are fixed by construction and written in each comment.
//
// Style: each program builds its IR inline in one function, with its argument lists as local values.
// An earlier version used helper methods that built IR; the generator then crashed during
// development and the cause was not isolated, so the fixtures avoid such helpers. See the
// implementation status in docs/Sublang_Dynamic_Profile.md.
public class SublangDynamicFixtures {
    // D1: a text Dyn created in main's scope survives a call to dyn_add that allocates; it is used afterwards and released with the scope. Expected 111 (same 1 + still 10 + truthy 100).
    public static SublangModule d1() {
        SublangBuilder builder = SublangBuilder("dyn-d1");
        Int span = builder.syntheticSpan("dyn:d1");
        SublangDynamicLibrary lib = SublangDynamicLibrary(builder);
        Int entry = builder.beginFunction("main", builder.intType(), 0, span);
        builder.module().setEntry(entry);
        builder.beginBlock();
        Int scope = builder.ops().scopeBegin(span);
        List<String> valueMode = List();
        valueMode.add("value");
        List<String> singleBorrow = List();
        singleBorrow.add("borrow_read");
        List<String> pairBorrow = List();
        pairBorrow.add("borrow_read");
        pairBorrow.add("borrow_read");
        List<String> noModes = List();
        List<Int> noArgs = List();
        List<Int> ab_args = List();
        ab_args.add(builder.ops().constString("ab", span));
        Int ab = builder.ops().callDirectOwned(lib.textFunction(), ab_args, valueMode, scope, span);
        List<Int> cd_args = List();
        cd_args.add(builder.ops().constString("cd", span));
        Int cd = builder.ops().callDirectOwned(lib.textFunction(), cd_args, valueMode, scope, span);
        List<Int> joined_args = List();
        joined_args.add(ab);
        joined_args.add(cd);
        List<String> joined_modes = List();
        joined_modes.add("borrow_read");
        joined_modes.add("borrow_read");
        Int joined = builder.ops().callDirectOwned(lib.addFunction(), joined_args, joined_modes, scope, span);
        List<Int> abcd_args = List();
        abcd_args.add(builder.ops().constString("abcd", span));
        Int abcd = builder.ops().callDirectOwned(lib.textFunction(), abcd_args, valueMode, scope, span);
        List<Int> same_args = List();
        same_args.add(joined);
        same_args.add(abcd);
        List<String> same_modes = List();
        same_modes.add("borrow_read");
        same_modes.add("borrow_read");
        Int same = builder.ops().callDirect(lib.equalFunction(), same_args, same_modes, span);
        List<Int> again_args = List();
        again_args.add(builder.ops().constString("ab", span));
        Int again = builder.ops().callDirectOwned(lib.textFunction(), again_args, valueMode, scope, span);
        List<Int> still_args = List();
        still_args.add(ab);
        still_args.add(again);
        List<String> still_modes = List();
        still_modes.add("borrow_read");
        still_modes.add("borrow_read");
        Int still = builder.ops().callDirect(lib.equalFunction(), still_args, still_modes, span);
        List<Int> truthyJoined_args = List();
        truthyJoined_args.add(joined);
        List<String> truthyJoined_modes = List();
        truthyJoined_modes.add("borrow_read");
        Int truthyJoined = builder.ops().callDirect(lib.truthyFunction(), truthyJoined_args, truthyJoined_modes, span);
        Int w1_yes = builder.newBlock();
        Int w1_no = builder.newBlock();
        Int w1_join = builder.newBlock();
        List<Int> w1_e1 = List();
        List<Int> w1_e2 = List();
        builder.ops().condBranch(same, w1_yes, w1_e1, w1_no, w1_e2, span);
        builder.enterBlock(w1_yes);
        List<Int> w1_t = List();
        w1_t.add(builder.ops().constInt(1, span));
        builder.ops().branchTo(w1_join, w1_t, span);
        builder.enterBlock(w1_no);
        List<Int> w1_f = List();
        w1_f.add(builder.ops().constInt(0, span));
        builder.ops().branchTo(w1_join, w1_f, span);
        builder.enterBlock(w1_join);
        Int w1 = builder.addBlockParam(builder.intType());
        Int w2_yes = builder.newBlock();
        Int w2_no = builder.newBlock();
        Int w2_join = builder.newBlock();
        List<Int> w2_e1 = List();
        List<Int> w2_e2 = List();
        builder.ops().condBranch(still, w2_yes, w2_e1, w2_no, w2_e2, span);
        builder.enterBlock(w2_yes);
        List<Int> w2_t = List();
        w2_t.add(builder.ops().constInt(10, span));
        builder.ops().branchTo(w2_join, w2_t, span);
        builder.enterBlock(w2_no);
        List<Int> w2_f = List();
        w2_f.add(builder.ops().constInt(0, span));
        builder.ops().branchTo(w2_join, w2_f, span);
        builder.enterBlock(w2_join);
        Int w2 = builder.addBlockParam(builder.intType());
        Int w3_yes = builder.newBlock();
        Int w3_no = builder.newBlock();
        Int w3_join = builder.newBlock();
        List<Int> w3_e1 = List();
        List<Int> w3_e2 = List();
        builder.ops().condBranch(truthyJoined, w3_yes, w3_e1, w3_no, w3_e2, span);
        builder.enterBlock(w3_yes);
        List<Int> w3_t = List();
        w3_t.add(builder.ops().constInt(100, span));
        builder.ops().branchTo(w3_join, w3_t, span);
        builder.enterBlock(w3_no);
        List<Int> w3_f = List();
        w3_f.add(builder.ops().constInt(0, span));
        builder.ops().branchTo(w3_join, w3_f, span);
        builder.enterBlock(w3_join);
        Int w3 = builder.addBlockParam(builder.intType());
        Int s1 = builder.ops().intBinary("int.add", w1, w2, "wrap", 0, span);
        Int answer = builder.ops().intBinary("int.add", s1, w3, "wrap", 0, span);
        builder.ops().scopeEnd(scope, span);
        builder.ops().returnValue(answer, span);
        return builder.module();
    }

    // D2: greet() returns an owned text Dyn built in its own scope; main uses it and releases it. Expected 11 (equal 1 + truthy 10).
    public static SublangModule d2() {
        SublangBuilder builder = SublangBuilder("dyn-d2");
        Int span = builder.syntheticSpan("dyn:d2");
        SublangDynamicLibrary lib = SublangDynamicLibrary(builder);
        Int greet = builder.beginFunction("greet", lib.layout().dynRef(), 0, span);
        builder.beginBlock();
        Int gScope = builder.ops().scopeBegin(span);
        List<String> gValueMode = List();
        gValueMode.add("value");
        List<Int> gAb_args = List();
        gAb_args.add(builder.ops().constString("ab", span));
        Int gAb = builder.ops().callDirectOwned(lib.textFunction(), gAb_args, gValueMode, gScope, span);
        List<Int> gCd_args = List();
        gCd_args.add(builder.ops().constString("cd", span));
        Int gCd = builder.ops().callDirectOwned(lib.textFunction(), gCd_args, gValueMode, gScope, span);
        List<Int> gJoined_args = List();
        gJoined_args.add(gAb);
        gJoined_args.add(gCd);
        List<String> gJoined_modes = List();
        gJoined_modes.add("borrow_read");
        gJoined_modes.add("borrow_read");
        Int gJoined = builder.ops().callDirectOwned(lib.addFunction(), gJoined_args, gJoined_modes, gScope, span);
        builder.ops().returnOwned(gJoined, span);
        Int entry = builder.beginFunction("main", builder.intType(), 0, span);
        builder.module().setEntry(entry);
        builder.beginBlock();
        Int scope = builder.ops().scopeBegin(span);
        List<String> valueMode = List();
        valueMode.add("value");
        List<String> singleBorrow = List();
        singleBorrow.add("borrow_read");
        List<String> pairBorrow = List();
        pairBorrow.add("borrow_read");
        pairBorrow.add("borrow_read");
        List<Int> noArgs = List();
        List<String> noModes = List();
        List<Int> greeting_args = List();
        List<String> greeting_modes = List();
        Int greeting = builder.ops().callDirectOwned(greet, greeting_args, greeting_modes, scope, span);
        List<Int> abcd_args = List();
        abcd_args.add(builder.ops().constString("abcd", span));
        Int abcd = builder.ops().callDirectOwned(lib.textFunction(), abcd_args, valueMode, scope, span);
        List<Int> same_args = List();
        same_args.add(greeting);
        same_args.add(abcd);
        List<String> same_modes = List();
        same_modes.add("borrow_read");
        same_modes.add("borrow_read");
        Int same = builder.ops().callDirect(lib.equalFunction(), same_args, same_modes, span);
        List<Int> truthyGreeting_args = List();
        truthyGreeting_args.add(greeting);
        List<String> truthyGreeting_modes = List();
        truthyGreeting_modes.add("borrow_read");
        Int truthyGreeting = builder.ops().callDirect(lib.truthyFunction(), truthyGreeting_args, truthyGreeting_modes, span);
        Int w1_yes = builder.newBlock();
        Int w1_no = builder.newBlock();
        Int w1_join = builder.newBlock();
        List<Int> w1_e1 = List();
        List<Int> w1_e2 = List();
        builder.ops().condBranch(same, w1_yes, w1_e1, w1_no, w1_e2, span);
        builder.enterBlock(w1_yes);
        List<Int> w1_t = List();
        w1_t.add(builder.ops().constInt(1, span));
        builder.ops().branchTo(w1_join, w1_t, span);
        builder.enterBlock(w1_no);
        List<Int> w1_f = List();
        w1_f.add(builder.ops().constInt(0, span));
        builder.ops().branchTo(w1_join, w1_f, span);
        builder.enterBlock(w1_join);
        Int w1 = builder.addBlockParam(builder.intType());
        Int w2_yes = builder.newBlock();
        Int w2_no = builder.newBlock();
        Int w2_join = builder.newBlock();
        List<Int> w2_e1 = List();
        List<Int> w2_e2 = List();
        builder.ops().condBranch(truthyGreeting, w2_yes, w2_e1, w2_no, w2_e2, span);
        builder.enterBlock(w2_yes);
        List<Int> w2_t = List();
        w2_t.add(builder.ops().constInt(10, span));
        builder.ops().branchTo(w2_join, w2_t, span);
        builder.enterBlock(w2_no);
        List<Int> w2_f = List();
        w2_f.add(builder.ops().constInt(0, span));
        builder.ops().branchTo(w2_join, w2_f, span);
        builder.enterBlock(w2_join);
        Int w2 = builder.addBlockParam(builder.intType());
        Int answer = builder.ops().intBinary("int.add", w1, w2, "wrap", 0, span);
        builder.ops().scopeEnd(scope, span);
        builder.ops().returnValue(answer, span);
        return builder.module();
    }

    // D3: exact equality, promotion, bool/nil/NaN truthiness. Weights: 1 int 2^53+1 vs float 2^53 is false; 2 int 2^53 vs float 2^53 is true; 4 int 1 + float 0.5 equals float 1.5; 10 * (to_int of 1 + 0.5 + 0.5 = 2); 100 truthy(true); 200 not truthy(false); 400 not truthy(nil); 800 not truthy(NaN). Expected 1527.
    public static SublangModule d3() {
        SublangBuilder builder = SublangBuilder("dyn-d3");
        Int span = builder.syntheticSpan("dyn:d3");
        SublangDynamicLibrary lib = SublangDynamicLibrary(builder);
        Int entry = builder.beginFunction("main", builder.intType(), 0, span);
        builder.module().setEntry(entry);
        builder.beginBlock();
        Int scope = builder.ops().scopeBegin(span);
        List<String> valueMode = List();
        valueMode.add("value");
        List<String> singleBorrow = List();
        singleBorrow.add("borrow_read");
        List<String> pairBorrow = List();
        pairBorrow.add("borrow_read");
        pairBorrow.add("borrow_read");
        List<String> noModes = List();
        List<Int> noArgs = List();
        List<Int> bigInt_args = List();
        bigInt_args.add(builder.ops().constInt(9007199254740993, span));
        Int bigInt = builder.ops().callDirectOwned(lib.intFunction(), bigInt_args, valueMode, scope, span);
        List<Int> twoPow53_args = List();
        twoPow53_args.add(builder.ops().constFloatBits(4845873199050653696, span));
        Int twoPow53 = builder.ops().callDirectOwned(lib.floatFunction(), twoPow53_args, valueMode, scope, span);
        List<Int> eqA_args = List();
        eqA_args.add(bigInt);
        eqA_args.add(twoPow53);
        List<String> eqA_modes = List();
        eqA_modes.add("borrow_read");
        eqA_modes.add("borrow_read");
        Int eqA = builder.ops().callDirect(lib.equalFunction(), eqA_args, eqA_modes, span);
        List<Int> exactInt_args = List();
        exactInt_args.add(builder.ops().constInt(9007199254740992, span));
        Int exactInt = builder.ops().callDirectOwned(lib.intFunction(), exactInt_args, valueMode, scope, span);
        List<Int> twoPow53Again_args = List();
        twoPow53Again_args.add(builder.ops().constFloatBits(4845873199050653696, span));
        Int twoPow53Again = builder.ops().callDirectOwned(lib.floatFunction(), twoPow53Again_args, valueMode, scope, span);
        List<Int> eqB_args = List();
        eqB_args.add(exactInt);
        eqB_args.add(twoPow53Again);
        List<String> eqB_modes = List();
        eqB_modes.add("borrow_read");
        eqB_modes.add("borrow_read");
        Int eqB = builder.ops().callDirect(lib.equalFunction(), eqB_args, eqB_modes, span);
        List<Int> one_args = List();
        one_args.add(builder.ops().constInt(1, span));
        Int one = builder.ops().callDirectOwned(lib.intFunction(), one_args, valueMode, scope, span);
        List<Int> half_args = List();
        half_args.add(builder.ops().constFloatBits(4602678819172646912, span));
        Int half = builder.ops().callDirectOwned(lib.floatFunction(), half_args, valueMode, scope, span);
        List<Int> promoted_args = List();
        promoted_args.add(one);
        promoted_args.add(half);
        List<String> promoted_modes = List();
        promoted_modes.add("borrow_read");
        promoted_modes.add("borrow_read");
        Int promoted = builder.ops().callDirectOwned(lib.addFunction(), promoted_args, promoted_modes, scope, span);
        List<Int> onePointFive_args = List();
        onePointFive_args.add(builder.ops().constFloatBits(4609434218613702656, span));
        Int onePointFive = builder.ops().callDirectOwned(lib.floatFunction(), onePointFive_args, valueMode, scope, span);
        List<Int> eqC_args = List();
        eqC_args.add(promoted);
        eqC_args.add(onePointFive);
        List<String> eqC_modes = List();
        eqC_modes.add("borrow_read");
        eqC_modes.add("borrow_read");
        Int eqC = builder.ops().callDirect(lib.equalFunction(), eqC_args, eqC_modes, span);
        List<Int> halfAgain_args = List();
        halfAgain_args.add(builder.ops().constFloatBits(4602678819172646912, span));
        Int halfAgain = builder.ops().callDirectOwned(lib.floatFunction(), halfAgain_args, valueMode, scope, span);
        List<Int> twice_args = List();
        twice_args.add(promoted);
        twice_args.add(halfAgain);
        List<String> twice_modes = List();
        twice_modes.add("borrow_read");
        twice_modes.add("borrow_read");
        Int twice = builder.ops().callDirectOwned(lib.addFunction(), twice_args, twice_modes, scope, span);
        List<Int> integral_args = List();
        integral_args.add(twice);
        List<String> integral_modes = List();
        integral_modes.add("borrow_read");
        Int integral = builder.ops().callDirect(lib.toIntFunction(), integral_args, integral_modes, span);
        List<Int> trueValue_args = List();
        trueValue_args.add(builder.ops().constBool(true, span));
        Int trueValue = builder.ops().callDirectOwned(lib.boolFunction(), trueValue_args, valueMode, scope, span);
        List<Int> truthyTrue_args = List();
        truthyTrue_args.add(trueValue);
        List<String> truthyTrue_modes = List();
        truthyTrue_modes.add("borrow_read");
        Int truthyTrue = builder.ops().callDirect(lib.truthyFunction(), truthyTrue_args, truthyTrue_modes, span);
        List<Int> falseValue_args = List();
        falseValue_args.add(builder.ops().constBool(false, span));
        Int falseValue = builder.ops().callDirectOwned(lib.boolFunction(), falseValue_args, valueMode, scope, span);
        List<Int> truthyFalse_args = List();
        truthyFalse_args.add(falseValue);
        List<String> truthyFalse_modes = List();
        truthyFalse_modes.add("borrow_read");
        Int truthyFalse = builder.ops().callDirect(lib.truthyFunction(), truthyFalse_args, truthyFalse_modes, span);
        Int nilItem = builder.ops().callDirectOwned(lib.nilFunction(), noArgs, noModes, scope, span);
        List<Int> truthyNil_args = List();
        truthyNil_args.add(nilItem);
        List<String> truthyNil_modes = List();
        truthyNil_modes.add("borrow_read");
        Int truthyNil = builder.ops().callDirect(lib.truthyFunction(), truthyNil_args, truthyNil_modes, span);
        List<Int> nanValue_args = List();
        nanValue_args.add(builder.ops().constFloatBits(9221120237041090560, span));
        Int nanValue = builder.ops().callDirectOwned(lib.floatFunction(), nanValue_args, valueMode, scope, span);
        List<Int> truthyNan_args = List();
        truthyNan_args.add(nanValue);
        List<String> truthyNan_modes = List();
        truthyNan_modes.add("borrow_read");
        Int truthyNan = builder.ops().callDirect(lib.truthyFunction(), truthyNan_args, truthyNan_modes, span);
        Int ten = builder.ops().constInt(10, span);
        Int scaled = builder.ops().intBinary("int.mul", integral, ten, "wrap", 0, span);
        Int falseConst1 = builder.ops().constBool(false, span);
        Int notEqualA = builder.ops().compare("eq", eqA, falseConst1, span);
        Int falseConst2 = builder.ops().constBool(false, span);
        Int notTruthyFalse = builder.ops().compare("eq", truthyFalse, falseConst2, span);
        Int falseConst3 = builder.ops().constBool(false, span);
        Int notTruthyNil = builder.ops().compare("eq", truthyNil, falseConst3, span);
        Int falseConst4 = builder.ops().constBool(false, span);
        Int notTruthyNan = builder.ops().compare("eq", truthyNan, falseConst4, span);
        Int weightA_yes = builder.newBlock();
        Int weightA_no = builder.newBlock();
        Int weightA_join = builder.newBlock();
        List<Int> weightA_e1 = List();
        List<Int> weightA_e2 = List();
        builder.ops().condBranch(notEqualA, weightA_yes, weightA_e1, weightA_no, weightA_e2, span);
        builder.enterBlock(weightA_yes);
        List<Int> weightA_t = List();
        weightA_t.add(builder.ops().constInt(1, span));
        builder.ops().branchTo(weightA_join, weightA_t, span);
        builder.enterBlock(weightA_no);
        List<Int> weightA_f = List();
        weightA_f.add(builder.ops().constInt(0, span));
        builder.ops().branchTo(weightA_join, weightA_f, span);
        builder.enterBlock(weightA_join);
        Int weightA = builder.addBlockParam(builder.intType());
        Int weightB_yes = builder.newBlock();
        Int weightB_no = builder.newBlock();
        Int weightB_join = builder.newBlock();
        List<Int> weightB_e1 = List();
        List<Int> weightB_e2 = List();
        builder.ops().condBranch(eqB, weightB_yes, weightB_e1, weightB_no, weightB_e2, span);
        builder.enterBlock(weightB_yes);
        List<Int> weightB_t = List();
        weightB_t.add(builder.ops().constInt(2, span));
        builder.ops().branchTo(weightB_join, weightB_t, span);
        builder.enterBlock(weightB_no);
        List<Int> weightB_f = List();
        weightB_f.add(builder.ops().constInt(0, span));
        builder.ops().branchTo(weightB_join, weightB_f, span);
        builder.enterBlock(weightB_join);
        Int weightB = builder.addBlockParam(builder.intType());
        Int weightC_yes = builder.newBlock();
        Int weightC_no = builder.newBlock();
        Int weightC_join = builder.newBlock();
        List<Int> weightC_e1 = List();
        List<Int> weightC_e2 = List();
        builder.ops().condBranch(eqC, weightC_yes, weightC_e1, weightC_no, weightC_e2, span);
        builder.enterBlock(weightC_yes);
        List<Int> weightC_t = List();
        weightC_t.add(builder.ops().constInt(4, span));
        builder.ops().branchTo(weightC_join, weightC_t, span);
        builder.enterBlock(weightC_no);
        List<Int> weightC_f = List();
        weightC_f.add(builder.ops().constInt(0, span));
        builder.ops().branchTo(weightC_join, weightC_f, span);
        builder.enterBlock(weightC_join);
        Int weightC = builder.addBlockParam(builder.intType());
        Int weightT_yes = builder.newBlock();
        Int weightT_no = builder.newBlock();
        Int weightT_join = builder.newBlock();
        List<Int> weightT_e1 = List();
        List<Int> weightT_e2 = List();
        builder.ops().condBranch(truthyTrue, weightT_yes, weightT_e1, weightT_no, weightT_e2, span);
        builder.enterBlock(weightT_yes);
        List<Int> weightT_t = List();
        weightT_t.add(builder.ops().constInt(100, span));
        builder.ops().branchTo(weightT_join, weightT_t, span);
        builder.enterBlock(weightT_no);
        List<Int> weightT_f = List();
        weightT_f.add(builder.ops().constInt(0, span));
        builder.ops().branchTo(weightT_join, weightT_f, span);
        builder.enterBlock(weightT_join);
        Int weightT = builder.addBlockParam(builder.intType());
        Int weightF_yes = builder.newBlock();
        Int weightF_no = builder.newBlock();
        Int weightF_join = builder.newBlock();
        List<Int> weightF_e1 = List();
        List<Int> weightF_e2 = List();
        builder.ops().condBranch(notTruthyFalse, weightF_yes, weightF_e1, weightF_no, weightF_e2, span);
        builder.enterBlock(weightF_yes);
        List<Int> weightF_t = List();
        weightF_t.add(builder.ops().constInt(200, span));
        builder.ops().branchTo(weightF_join, weightF_t, span);
        builder.enterBlock(weightF_no);
        List<Int> weightF_f = List();
        weightF_f.add(builder.ops().constInt(0, span));
        builder.ops().branchTo(weightF_join, weightF_f, span);
        builder.enterBlock(weightF_join);
        Int weightF = builder.addBlockParam(builder.intType());
        Int weightN_yes = builder.newBlock();
        Int weightN_no = builder.newBlock();
        Int weightN_join = builder.newBlock();
        List<Int> weightN_e1 = List();
        List<Int> weightN_e2 = List();
        builder.ops().condBranch(notTruthyNil, weightN_yes, weightN_e1, weightN_no, weightN_e2, span);
        builder.enterBlock(weightN_yes);
        List<Int> weightN_t = List();
        weightN_t.add(builder.ops().constInt(400, span));
        builder.ops().branchTo(weightN_join, weightN_t, span);
        builder.enterBlock(weightN_no);
        List<Int> weightN_f = List();
        weightN_f.add(builder.ops().constInt(0, span));
        builder.ops().branchTo(weightN_join, weightN_f, span);
        builder.enterBlock(weightN_join);
        Int weightN = builder.addBlockParam(builder.intType());
        Int weightNan_yes = builder.newBlock();
        Int weightNan_no = builder.newBlock();
        Int weightNan_join = builder.newBlock();
        List<Int> weightNan_e1 = List();
        List<Int> weightNan_e2 = List();
        builder.ops().condBranch(notTruthyNan, weightNan_yes, weightNan_e1, weightNan_no, weightNan_e2, span);
        builder.enterBlock(weightNan_yes);
        List<Int> weightNan_t = List();
        weightNan_t.add(builder.ops().constInt(800, span));
        builder.ops().branchTo(weightNan_join, weightNan_t, span);
        builder.enterBlock(weightNan_no);
        List<Int> weightNan_f = List();
        weightNan_f.add(builder.ops().constInt(0, span));
        builder.ops().branchTo(weightNan_join, weightNan_f, span);
        builder.enterBlock(weightNan_join);
        Int weightNan = builder.addBlockParam(builder.intType());
        Int t1 = builder.ops().intBinary("int.add", weightA, weightB, "wrap", 0, span);
        Int t2 = builder.ops().intBinary("int.add", t1, weightC, "wrap", 0, span);
        Int t3 = builder.ops().intBinary("int.add", t2, scaled, "wrap", 0, span);
        Int t4 = builder.ops().intBinary("int.add", t3, weightT, "wrap", 0, span);
        Int t5 = builder.ops().intBinary("int.add", t4, weightF, "wrap", 0, span);
        Int t6 = builder.ops().intBinary("int.add", t5, weightN, "wrap", 0, span);
        Int total = builder.ops().intBinary("int.add", t6, weightNan, "wrap", 0, span);
        builder.ops().scopeEnd(scope, span);
        builder.ops().returnValue(total, span);
        return builder.module();
    }

    // D4: int + text aborts with dyn.type_error (SIGABRT, no output).
