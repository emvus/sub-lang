namespace sublang::ir;

use sublang::body::SublangFunction;
use sublang::ir::SublangCursor;
use sublang::ir::SublangModule;
use sublang::ir::SublangOperationBuilder;
use sublang::vocabulary::SublangVocabulary;
use sublang::ir::data::SublangCollectionBuilder;
use sublang::ir::data::SublangBondBuilder;

// Builds High IR for one module: it declares the module's entities and starts functions and
// blocks. Operations are appended through ops(), at the block the cursor points at. The builder
// records what it is told and refuses mutation after freeze(); the verifier judges the module.
// Every function it begins gets the startup profile and the conservative effect summary unless
// the caller names another profile explicitly.
public class SublangBuilder {
    private SublangModule module;
    private SublangCursor cursor;
    private SublangOperationBuilder operations;
    private Int defaultProfileId;

    public SublangBuilder(String moduleName) {
        this.module = SublangModule(moduleName);
        this.cursor = SublangCursor(this.module);
        this.operations = SublangOperationBuilder(this.cursor);
        this.defaultProfileId = this.module.semantics().addProfile(SublangVocabulary.startupProfileName(), SublangVocabulary.startupProfileVersion(), SublangVocabulary.startupIntegerRules(), SublangVocabulary.startupFloatRules(), SublangVocabulary.startupFailureModel(), SublangVocabulary.startupUnwindingModel());
    }

    public SublangModule module() {
        return this.module;
    }

    public SublangOperationBuilder ops() {
        return this.operations;
    }

    public SublangCollectionBuilder collections() { return SublangCollectionBuilder(this.cursor); }
    public SublangBondBuilder bonds() { return SublangBondBuilder(this.cursor); }
    public Int bondType(Int type) { return this.module.types().bondTypeFor(type); }
    public Int listType(Int element, Int span) { return this.module.types().addType("List", "List<" + this.module.types().typeNameOf(element) + ">", 0, false, element, span); }

    public Int startupProfile() {
        return this.defaultProfileId;
    }

    public Void freeze() {
        this.module.freeze();
    }

    public Int voidType() {
        return this.module.types().voidType();
    }

    public Int boolType() {
        return this.module.types().boolType();
    }

    public Int intType() {
        return this.module.types().intType();
    }

    public Int byteType() {
        return this.module.types().byteType();
    }

    public Int stringType() {
        return this.module.types().stringType();
    }

    public Int floatType() {
        return this.module.types().floatType();
    }

    public Int source(String name) {
        return this.module.addSource(name);
    }

    public Int span(Int sourceId, Int line, Int column) {
        return this.module.addSpan(sourceId, line, column, "");
    }

    public Int syntheticSpan(String origin) {
        return this.module.addSpan(0, 0, 0, origin);
    }

    public Int recordType(String name, Int span) {
        return this.module.types().addType("Record", name, 0, false, 0, span);
    }

    // A class that extends `base`; its fields must begin with the base fields.
    public Int classTypeExtending(String name, Int base, Int span) {
        return this.module.types().addType("Class", name, 0, false, base, span);
    }

    // Closed-world dispatch registration (Wire feature ext.oo.v1).
    public Void registerClass(Int type, Int tag) { this.module.dispatch().addClass(type, tag); }
    public Int dispatchGroup(String name, Int root, Int tagField, Int prototype) { return this.module.dispatch().addGroup(name, root, tagField, prototype); }
    public Void dispatchEntry(Int group, Int tag, Int function) { this.module.dispatch().addEntry(group, tag, function); }

    public Int classType(String name, Int span) {
        return this.module.types().addType("Class", name, 0, false, 0, span);
    }

    public Int refType(Int classTypeId) {
        return this.module.types().refTypeFor(classTypeId);
    }

    public Int recordField(Int recordTypeId, String name, Int typeId, Int span) {
        return this.module.types().addField(recordTypeId, name, typeId, false, span);
    }

    public Int classField(Int classTypeId, String name, Int typeId, Bool mutable, Int span) {
        return this.module.types().addField(classTypeId, name, typeId, mutable, span);
    }

    // Default abort record by name; see SublangSemanticTable.failureId.
    public Int failure(String name) {
        return this.module.semantics().failureId(name);
    }

    // Explicit FailureAction record with its behavior, binding, signature and unwinding.
    public Int failureAction(String name, String behavior, String binding, String signature, Bool continues, String unwinding, Int span) {
        return this.module.semantics().addFailureAction(name, behavior, binding, signature, continues, unwinding, span);
    }

    public Int addLocation(String kind, String name, Int span) {
        return this.module.aliases().addLocation(kind, name, span);
    }

    // Recorded alias answer between two locations; see SublangAliasTable.aliasAnswer.
    public Int aliasFact(Int left, Int right, String answer, String origin, String proof, Int span) {
        return this.module.aliases().addAliasFact(left, right, answer, origin, proof, span);
    }

    // Explicit semantic profile, for callers that do not use the startup profile.
    public Int addProfile(String name, Int version, String integerRules, String floatRules, String failureModel, String unwindingModel) {
        return this.module.semantics().addProfile(name, version, integerRules, floatRules, failureModel, unwindingModel);
    }

    public Int beginFunction(String name, Int returnTypeId, Int methodOfId, Int span) {
        return this.beginFunctionWithProfile(name, returnTypeId, methodOfId, span, this.defaultProfileId);
    }

    public Int beginFunctionWithProfile(String name, Int returnTypeId, Int methodOfId, Int span, Int profileId) {
        if (this.module.isFrozen()) {
            this.module.refuse();
            return 0;
        }
        Int functionId = this.module.addFunction(name, returnTypeId, methodOfId, span);
        if (functionId == 0) {
            return 0;
        }
        this.cursor.enterFunction(functionId);
        SublangFunction fnEntry = this.cursor.currentFunction();
        fnEntry.setProfile(profileId);
        fnEntry.setEffectSummary(this.module.semantics().conservativeEffectSummary());
        return functionId;
    }

    // External function: no body, linkage external, a contract instead of blocks.
    // Calls to it are rejected by the verifier until a provider contract supports them.
    public Int declareExternal(String name, Int returnTypeId, Int span) {
        if (this.module.isFrozen()) {
            this.module.refuse();
            return 0;
        }
        Int functionId = this.module.addFunction(name, returnTypeId, 0, span);
        if (functionId == 0) {
            return 0;
        }
        this.cursor.enterFunction(functionId);
        SublangFunction fnEntry = this.cursor.currentFunction();
        fnEntry.setProfile(this.defaultProfileId);
        fnEntry.setEffectSummary(this.module.semantics().conservativeEffectSummary());
        fnEntry.setLinkage("external");
        fnEntry.setDefinition("contract");
        return functionId;
    }

    public Void setFunctionProfile(Int functionId, Int profileId) {
        if (this.module.hasFunction(functionId)) {
            this.module.functionAt(functionId).setProfile(profileId);
        }
    }

    public Int addParam(String name, Int typeId, String passing, Bool noEscape) {
        if (!this.cursor.functionReady()) {
            this.module.refuse();
            return 0;
        }
        return this.cursor.currentFunction().addParam(name, typeId, passing, noEscape);
    }

    public Int newBlock() {
        if (!this.cursor.functionReady()) {
            this.module.refuse();
            return 0;
        }
        return this.cursor.currentFunction().addBlock();
    }

    public Void enterBlock(Int blockId) {
        this.cursor.enterBlock(blockId);
    }

    public Int beginBlock() {
        Int blockId = this.newBlock();
        this.enterBlock(blockId);
        return blockId;
    }

    public Int addBlockParam(Int typeId) {
        if (!this.cursor.blockReady()) {
            this.module.refuse();
            return 0;
        }
        return this.cursor.currentFunction().addBlockParam(this.cursor.currentBlockId(), typeId);
    }
}
