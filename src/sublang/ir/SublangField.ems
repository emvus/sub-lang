namespace sublang::ir;

// Field of a record or class. The name is kept for diagnostics and the dump only.
public class SublangField {
    private Int fieldIdValue;
    private Int ownerIdValue;
    private String nameText;
    private Int fieldTypeId;
    private Bool mutableFlag;
    private Int spanIdValue;

    public SublangField(Int id, Int owner, String name, Int typeId, Bool mutable, Int span) {
        this.fieldIdValue = id;
        this.ownerIdValue = owner;
        this.nameText = name + "";
        this.fieldTypeId = typeId;
        this.mutableFlag = mutable;
        this.spanIdValue = span;
    }

    public Int id() {
        return this.fieldIdValue;
    }

    public Int owner() {
        return this.ownerIdValue;
    }

    public String name() {
        return this.nameText;
    }

    public Int typeId() {
        return this.fieldTypeId;
    }

    public Bool isMutable() {
        return this.mutableFlag;
    }

    public Int span() {
        return this.spanIdValue;
    }
}
