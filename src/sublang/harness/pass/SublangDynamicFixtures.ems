        singleBorrow.add("borrow_read");
        List<String> pairBorrow = List();
        pairBorrow.add("borrow_read");
        pairBorrow.add("borrow_read");
        List<String> noModes = List();
        List<Int> noArgs = List();
        List<Int> maximum_args = List();
        maximum_args.add(builder.ops().constInt(9223372036854775807, span));
        Int maximum = builder.ops().callDirectOwned(lib.intFunction(), maximum_args, valueMode, scope, span);
        List<Int> increment_args = List();
