namespace sublang::backend::llvmbond;

// Large stable strongly connected groups share a revision-checked external count.
// The reverse closure inside a candidate's forward closure is precisely its SCC.
// Typed visitors replace the Emerald-specific incoming-edge catalog.
public class SublangLlvmBondCache {
    public static String definitions() {
        String text = "%sublang.bond.component = type { i64, i64, i64 }\n@sublang.bond.revision = internal global i64 1\n@sublang.bond.cache.owner = internal global ptr null\n@sublang.bond.cache.changed = internal global i1 false\n@sublang.bond.cache.external = internal global i64 0\n";
        return text + SublangLlvmBondCache.revision() + SublangLlvmBondCache.adjust() + SublangLlvmBondCache.drop() + SublangLlvmBondCache.candidate() + SublangLlvmBondCache.reverse() + SublangLlvmBondCache.build();
    }

    private static String revision() {
        return "define internal void @sublang.bond.graph.changed() {\nentry:\n  %old = load i64, ptr @sublang.bond.revision\n  %full = icmp eq i64 %old, -1\n  br i1 %full, label %bad, label %ok\nbad:\n  call void @abort()\n  unreachable\nok:\n  %next = add i64 %old, 1\n  store i64 %next, ptr @sublang.bond.revision\n  ret void\n}\ndefine internal ptr @sublang.bond.cache.valid(ptr %meta) {\nentry:\n  %slot = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 13\n  %component = load ptr, ptr %slot\n  %null = icmp eq ptr %component, null\n  br i1 %null, label %invalid, label %check\ncheck:\n  %version = load i64, ptr %component\n  %current = load i64, ptr @sublang.bond.revision\n  %same = icmp eq i64 %version, %current\n  br i1 %same, label %valid, label %invalid\nvalid:\n  ret ptr %component\ninvalid:\n  ret ptr null\n}\n";
    }

    private static String adjust() {
        return "define internal void @sublang.bond.cache.adjust(ptr %payload, i64 %delta) {\nentry:\n  %meta = call ptr @sublang.bond.meta(ptr %payload)\n  %component = call ptr @sublang.bond.cache.valid(ptr %meta)\n  %null = icmp eq ptr %component, null\n  br i1 %null, label %done, label %adjust\nadjust:\n  %slot = getelementptr %sublang.bond.component, ptr %component, i32 0, i32 2\n  %old = load i64, ptr %slot\n  %add = icmp eq i64 %delta, 1\n  %limit = select i1 %add, i64 -1, i64 0\n  %invalid = icmp eq i64 %old, %limit\n  br i1 %invalid, label %bad, label %ok\nbad:\n  call void @abort()\n  unreachable\nok:\n  %next = add i64 %old, %delta\n  store i64 %next, ptr %slot\n  br label %done\ndone:\n  ret void\n}\n";
    }

    private static String drop() {
        return "define internal void @sublang.bond.cache.drop(ptr %meta) {\nentry:\n  %slot = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 13\n  %component = load ptr, ptr %slot\n  store ptr null, ptr %slot\n  %null = icmp eq ptr %component, null\n  br i1 %null, label %done, label %drop\ndrop:\n  %members = getelementptr %sublang.bond.component, ptr %component, i32 0, i32 1\n  %old = load i64, ptr %members\n  %next = sub i64 %old, 1\n  store i64 %next, ptr %members\n  %last = icmp eq i64 %next, 0\n  br i1 %last, label %free, label %done\nfree:\n  call void @free(ptr %component)\n  br label %done\ndone:\n  ret void\n}\n";
    }

    private static String candidate() {
        return "define internal void @sublang.bond.candidate(ptr %payload, i1 %request) {\nentry:\n  %null = icmp eq ptr %payload, null\n  %skip = xor i1 %request, true\n  %ignore = or i1 %null, %skip\n  br i1 %ignore, label %done, label %check\ncheck:\n  %meta = call ptr @sublang.bond.meta(ptr %payload)\n  %rs = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 2\n  %roots = load i64, ptr %rs\n  %rooted = icmp ne i64 %roots, 0\n  br i1 %rooted, label %done, label %cache\ncache:\n  %component = call ptr @sublang.bond.cache.valid(ptr %meta)\n  %uncached = icmp eq ptr %component, null\n  br i1 %uncached, label %queue, label %external\nexternal:\n  %es = getelementptr %sublang.bond.component, ptr %component, i32 0, i32 2\n  %count = load i64, ptr %es\n  %live = icmp ne i64 %count, 0\n  br i1 %live, label %done, label %queue\nqueue:\n  %slot = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 11\n  store i1 true, ptr %slot\n  store i1 true, ptr @sublang.bond.dirty\n  br label %done\ndone:\n  ret void\n}\n";
    }

    private static String reverse() {
        String text = "define internal void @sublang.bond.cache.reverse.edge(ptr %child) {\nentry:\n  %null = icmp eq ptr %child, null\n  br i1 %null, label %done, label %check\ncheck:\n  %meta = call ptr @sublang.bond.meta(ptr %child)\n  %ms = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 3\n  %member = load i1, ptr %ms\n  %rs = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 12\n  %reverse = load i1, ptr %rs\n  %inside = and i1 %member, %reverse\n  br i1 %inside, label %mark, label %done\nmark:\n  %owner = load ptr, ptr @sublang.bond.cache.owner\n  %slot = getelementptr %sublang.bond.meta, ptr %owner, i32 0, i32 12\n  %was = load i1, ptr %slot\n  %new = xor i1 %was, true\n  %changed = load i1, ptr @sublang.bond.cache.changed\n  %more = or i1 %changed, %new\n  store i1 true, ptr %slot\n  store i1 %more, ptr @sublang.bond.cache.changed\n  br label %done\ndone:\n  ret void\n}\n";
        return text + "define internal void @sublang.bond.cache.subtract(ptr %child) {\nentry:\n  %null = icmp eq ptr %child, null\n  br i1 %null, label %done, label %check\ncheck:\n  %meta = call ptr @sublang.bond.meta(ptr %child)\n  %ms = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 3\n  %member = load i1, ptr %ms\n  %rs = getelementptr %sublang.bond.meta, ptr %meta, i32 0, i32 12\n  %reverse = load i1, ptr %rs\n  %inside = and i1 %member, %reverse\n  br i1 %inside, label %subtract, label %done\nsubtract:\n  %old = load i64, ptr @sublang.bond.cache.external\n  %next = sub i64 %old, 1\n  store i64 %next, ptr @sublang.bond.cache.external\n  br label %done\ndone:\n  ret void\n}\n";
    }

    private static String build() {
        String text = "define internal void @sublang.bond.cache.build(ptr %candidate) {\nentry:\n  %count = load i64, ptr @sublang.bond.scan.count\n  %small = icmp ult i64 %count, 64\n  br i1 %small, label %done, label %start\nstart:\n  %head = load ptr, ptr @sublang.bond.scan\n  %candidate.rs = getelementptr %sublang.bond.meta, ptr %candidate, i32 0, i32 12\n  store i1 true, ptr %candidate.rs\n  store i32 5, ptr @sublang.bond.phase\n  br label %round\nround:\n  store i1 false, ptr @sublang.bond.cache.changed\n  br label %reverse\nreverse:\n  %node = phi ptr [ %head, %round ], [ %next, %advance ]\n  %empty = icmp eq ptr %node, null\n  br i1 %empty, label %round.end, label %inspect\ninspect:\n  %rs = getelementptr %sublang.bond.meta, ptr %node, i32 0, i32 12\n  %known = load i1, ptr %rs\n  br i1 %known, label %advance, label %visit\nvisit:\n  store ptr %node, ptr @sublang.bond.cache.owner\n  %ts = getelementptr %sublang.bond.meta, ptr %node, i32 0, i32 4\n  %callback = load ptr, ptr %ts\n  %ps = getelementptr %sublang.bond.meta, ptr %node, i32 0, i32 5\n  %payload = load ptr, ptr %ps\n  call void %callback(ptr %payload, i1 false)\n  br label %advance\nadvance:\n  %ss = getelementptr %sublang.bond.meta, ptr %node, i32 0, i32 9\n  %next = load ptr, ptr %ss\n  br label %reverse\nround.end:\n  %changed = load i1, ptr @sublang.bond.cache.changed\n  br i1 %changed, label %round, label %count.start\ncount.start:\n  store i64 0, ptr @sublang.bond.cache.external\n  br label %members\nmembers:\n  %member = phi ptr [ %head, %count.start ], [ %member.next, %members.advance ]\n  %members.count = phi i64 [ 0, %count.start ], [ %members.next, %members.advance ]\n  %members.empty = icmp eq ptr %member, null\n  br i1 %members.empty, label %members.done, label %members.check\nmembers.check:\n  %member.rs = getelementptr %sublang.bond.meta, ptr %member, i32 0, i32 12\n  %included = load i1, ptr %member.rs\n  br i1 %included, label %members.add, label %members.advance\nmembers.add:\n  %member.root.slot = getelementptr %sublang.bond.meta, ptr %member, i32 0, i32 2\n  %member.edge.slot = getelementptr %sublang.bond.meta, ptr %member, i32 0, i32 7\n  %roots = load i64, ptr %member.root.slot\n  %edges = load i64, ptr %member.edge.slot\n  %total = add i64 %roots, %edges\n  %external.old = load i64, ptr @sublang.bond.cache.external\n  %external.new = add i64 %external.old, %total\n  store i64 %external.new, ptr @sublang.bond.cache.external\n  br label %members.advance\nmembers.advance:\n  %increment = zext i1 %included to i64\n  %members.next = add i64 %members.count, %increment\n  %member.ss = getelementptr %sublang.bond.meta, ptr %member, i32 0, i32 9\n  %member.next = load ptr, ptr %member.ss\n  br label %members\nmembers.done:\n  %too.small = icmp ult i64 %members.count, 64\n  br i1 %too.small, label %done, label %subtract.start\nsubtract.start:\n  store i32 6, ptr @sublang.bond.phase\n  br label %subtract\nsubtract:\n  %subtract.node = phi ptr [ %head, %subtract.start ], [ %subtract.next, %subtract.advance ]\n  %subtract.empty = icmp eq ptr %subtract.node, null\n  br i1 %subtract.empty, label %allocate, label %subtract.check\nsubtract.check:\n  %subtract.rs = getelementptr %sublang.bond.meta, ptr %subtract.node, i32 0, i32 12\n  %subtract.member = load i1, ptr %subtract.rs\n  br i1 %subtract.member, label %subtract.visit, label %subtract.advance\nsubtract.visit:\n  %subtract.ts = getelementptr %sublang.bond.meta, ptr %subtract.node, i32 0, i32 4\n  %subtract.callback = load ptr, ptr %subtract.ts\n  %subtract.ps = getelementptr %sublang.bond.meta, ptr %subtract.node, i32 0, i32 5\n  %subtract.payload = load ptr, ptr %subtract.ps\n  call void %subtract.callback(ptr %subtract.payload, i1 false)\n  br label %subtract.advance\nsubtract.advance:\n  %subtract.ss = getelementptr %sublang.bond.meta, ptr %subtract.node, i32 0, i32 9\n  %subtract.next = load ptr, ptr %subtract.ss\n  br label %subtract\nallocate:\n  %component = call ptr @sublang.allocate(i64 24)\n  %revision = load i64, ptr @sublang.bond.revision\n  store i64 %revision, ptr %component\n  %component.members = getelementptr %sublang.bond.component, ptr %component, i32 0, i32 1\n  store i64 %members.count, ptr %component.members\n  %external = load i64, ptr @sublang.bond.cache.external\n  %component.external = getelementptr %sublang.bond.component, ptr %component, i32 0, i32 2\n  store i64 %external, ptr %component.external\n  br label %attach\nattach:\n  %attach.node = phi ptr [ %head, %allocate ], [ %attach.next, %attach.advance ]\n  %attach.empty = icmp eq ptr %attach.node, null\n  br i1 %attach.empty, label %done, label %attach.check\nattach.check:\n  %attach.rs = getelementptr %sublang.bond.meta, ptr %attach.node, i32 0, i32 12\n  %attach.member = load i1, ptr %attach.rs\n  br i1 %attach.member, label %attach.set, label %attach.advance\nattach.set:\n  call void @sublang.bond.cache.drop(ptr %attach.node)\n  %attach.cs = getelementptr %sublang.bond.meta, ptr %attach.node, i32 0, i32 13\n  store ptr %component, ptr %attach.cs\n  br label %attach.advance\nattach.advance:\n  %attach.ss = getelementptr %sublang.bond.meta, ptr %attach.node, i32 0, i32 9\n  %attach.next = load ptr, ptr %attach.ss\n  br label %attach\ndone:\n  ret void\n}\n";
        return text;
    }
}
