namespace sublang::backend::llvmdata;

// Platform access of the byte-text extension (text.from_file, text.write_file, text.print, text.argument):
// runtime functions over the host libc. Texts are byte lists, so a path is copied into a NUL-terminated
// buffer first. A file that cannot be opened reads as empty and writes as false; an argument past the last
// is empty. The process arguments are stored by `main`.
public class SublangLlvmIoRuntime {
    public static String definitions() {
        String text = "declare ptr @fopen(ptr, ptr)\ndeclare i64 @fread(ptr, i64, i64, ptr)\ndeclare i64 @fwrite(ptr, i64, i64, ptr)\ndeclare i32 @fclose(ptr)\ndeclare i64 @write(i32, ptr, i64)\ndeclare i64 @strlen(ptr)\ndeclare void @exit(i32) noreturn\n";
        text = text + "@sublang.argc = internal global i32 0\n@sublang.argv = internal global ptr null\n";
        text = text + "@sublang.io.read.mode = private constant [3 x i8] c\"rb\\00\"\n@sublang.io.write.mode = private constant [3 x i8] c\"wb\\00\"\n";
        text = text + SublangLlvmIoRuntime.path();
        text = text + SublangLlvmIoRuntime.read();
        text = text + SublangLlvmIoRuntime.write();
        text = text + SublangLlvmIoRuntime.print();
        text = text + SublangLlvmIoRuntime.error();
        text = text + SublangLlvmIoRuntime.exists();
        text = text + SublangLlvmIoRuntime.process();
        return text + SublangLlvmIoRuntime.argument();
    }

    // A NUL-terminated copy of the bytes of a list; the caller frees it.
    private static String path() {
        return "define internal ptr @sublang.io.path(ptr %list) {\nentry:\n  %ls = getelementptr %sublang.list, ptr %list, i32 0, i32 1\n  %len32 = load i32, ptr %ls\n  %len = zext i32 %len32 to i64\n  %size = add i64 %len, 1\n  %buffer = call ptr @sublang.allocate(i64 %size)\n  %data = load ptr, ptr %list\n  %empty = icmp eq i64 %len, 0\n  br i1 %empty, label %end, label %copy\ncopy:\n  call void @llvm.memcpy.p0.p0.i64(ptr %buffer, ptr %data, i64 %len, i1 false)\n  br label %end\nend:\n  %last = getelementptr i8, ptr %buffer, i64 %len\n  store i8 0, ptr %last\n  ret ptr %buffer\n}\n";
    }

    private static String read() {
        return "define internal void @sublang.io.read(ptr %destination, ptr %path) {\nentry:\n  %block = alloca [4096 x i8]\n  %name = call ptr @sublang.io.path(ptr %path)\n  %file = call ptr @fopen(ptr %name, ptr @sublang.io.read.mode)\n  call void @free(ptr %name)\n  %missing = icmp eq ptr %file, null\n  br i1 %missing, label %done, label %next\nnext:\n  %count = call i64 @fread(ptr %block, i64 1, i64 4096, ptr %file)\n  %finished = icmp eq i64 %count, 0\n  br i1 %finished, label %close, label %take\ntake:\n  call void @sublang.text.append(ptr %destination, ptr %block, i64 %count)\n  br label %next\nclose:\n  %closed = call i32 @fclose(ptr %file)\n  br label %done\ndone:\n  ret void\n}\n";
    }

    private static String write() {
        return "define internal i1 @sublang.io.write(ptr %path, ptr %data) {\nentry:\n  %name = call ptr @sublang.io.path(ptr %path)\n  %file = call ptr @fopen(ptr %name, ptr @sublang.io.write.mode)\n  call void @free(ptr %name)\n  %missing = icmp eq ptr %file, null\n  br i1 %missing, label %fail, label %open\nopen:\n  %ls = getelementptr %sublang.list, ptr %data, i32 0, i32 1\n  %len32 = load i32, ptr %ls\n  %len = zext i32 %len32 to i64\n  %bytes = load ptr, ptr %data\n  %empty = icmp eq i64 %len, 0\n  br i1 %empty, label %close, label %put\nput:\n  %written = call i64 @fwrite(ptr %bytes, i64 1, i64 %len, ptr %file)\n  br label %close\nclose:\n  %count = phi i64 [0, %open], [%written, %put]\n  %closed = call i32 @fclose(ptr %file)\n  %whole = icmp eq i64 %count, %len\n  %clean = icmp eq i32 %closed, 0\n  %ok = and i1 %whole, %clean\n  ret i1 %ok\nfail:\n  ret i1 false\n}\n";
    }

    private static String print() {
        return "define internal void @sublang.io.print(ptr %data) {\nentry:\n  %ls = getelementptr %sublang.list, ptr %data, i32 0, i32 1\n  %len32 = load i32, ptr %ls\n  %len = zext i32 %len32 to i64\n  %bytes = load ptr, ptr %data\n  br label %check\ncheck:\n  %offset = phi i64 [0, %entry], [%next, %step]\n  %more = icmp ult i64 %offset, %len\n  br i1 %more, label %step, label %done\nstep:\n  %at = getelementptr i8, ptr %bytes, i64 %offset\n  %left = sub i64 %len, %offset\n  %sent = call i64 @write(i32 1, ptr %at, i64 %left)\n  %failed = icmp sle i64 %sent, 0\n  %next = add i64 %offset, %sent\n  br i1 %failed, label %done, label %check\ndone:\n  ret void\n}\n";
    }

    // Argument 0 is the first one after the program name.
    private static String argument() {
        return "define internal void @sublang.io.argument(ptr %destination, i64 %index) {\nentry:\n  %count32 = load i32, ptr @sublang.argc\n  %count = sext i32 %count32 to i64\n  %slot = add i64 %index, 1\n  %inside = icmp ult i64 %slot, %count\n  br i1 %inside, label %get, label %done\nget:\n  %vector = load ptr, ptr @sublang.argv\n  %cell = getelementptr ptr, ptr %vector, i64 %slot\n  %text = load ptr, ptr %cell\n  %length = call i64 @strlen(ptr %text)\n  call void @sublang.text.append(ptr %destination, ptr %text, i64 %length)\n  br label %done\ndone:\n  ret void\n}\n";
    }

    // Standard error: the same loop as print, on file descriptor 2.
    private static String error() {
        return "define internal void @sublang.io.error(ptr %data) {\nentry:\n  %ls = getelementptr %sublang.list, ptr %data, i32 0, i32 1\n  %len32 = load i32, ptr %ls\n  %len = zext i32 %len32 to i64\n  %bytes = load ptr, ptr %data\n  br label %check\ncheck:\n  %offset = phi i64 [0, %entry], [%next, %step]\n  %more = icmp ult i64 %offset, %len\n  br i1 %more, label %step, label %done\nstep:\n  %at = getelementptr i8, ptr %bytes, i64 %offset\n  %left = sub i64 %len, %offset\n  %sent = call i64 @write(i32 2, ptr %at, i64 %left)\n  %failed = icmp sle i64 %sent, 0\n  %next = add i64 %offset, %sent\n  br i1 %failed, label %done, label %check\ndone:\n  ret void\n}\n";
    }

    private static String exists() {
        return "define internal i1 @sublang.io.exists(ptr %path) {\nentry:\n  %name = call ptr @sublang.io.path(ptr %path)\n  %file = call ptr @fopen(ptr %name, ptr @sublang.io.read.mode)\n  call void @free(ptr %name)\n  %missing = icmp eq ptr %file, null\n  br i1 %missing, label %no, label %yes\nyes:\n  %closed = call i32 @fclose(ptr %file)\n  ret i1 true\nno:\n  ret i1 false\n}\n";
    }

    // The number of arguments after the program name, and the end of the process.
    private static String process() {
        String text = "define internal i64 @sublang.io.argc() {\nentry:\n  %count32 = load i32, ptr @sublang.argc\n  %count = sext i32 %count32 to i64\n  %rest = sub i64 %count, 1\n  %any = icmp sgt i64 %rest, 0\n  %answer = select i1 %any, i64 %rest, i64 0\n  ret i64 %answer\n}\n";
        return text + "define internal void @sublang.process.exit(i64 %code) {\nentry:\n  %status = trunc i64 %code to i32\n  call void @exit(i32 %status)\n  unreachable\n}\n";
    }
}
