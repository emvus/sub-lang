namespace sublang::dump;

use sublang::ir::SublangModule;
use sublang::model::SublangField;

// Formatting helpers shared by the dump classes. Names that refer to a missing entity print as
// "?<kind><id>" instead of failing, so a dump of a broken module still shows every reference.
public class SublangDumpText {
    public static String boolText(Bool value) {
        if (value) {
            return "true";
        }
        return "false";
    }

    // Raw 64-bit pattern as 16 lowercase hex digits. The loop takes the low nibble of a value
    // that is congruent to it modulo 16 and shifts the value down. The subtraction stays
    // inside the Int64 range, so no operation can overflow, even for negative bit patterns.
    public static String hex64(Int bits) {
        String digits = "0123456789abcdef";
        String out = "";
        Int value = bits;
        Int position = 0;
        while (position < 16) {
            Int low = ((value % 16) + 16) % 16;
            out = digits.substring(low, low + 1) + out;
            value = (value - low) / 16;
            position = position + 1;
        }
        return "0x" + out;
    }

    public static String listText(List<Int> values) {
        String text = "[";
        Int index = 0;
        while (index < values.length()) {
            String separator = "";
            if (index > 0) {
                separator = ",";
            }
            text = text + separator + values.get(index).toString();
            index = index + 1;
        }
        return text + "]";
    }

    public static String typeName(SublangModule module, Int typeId) {
        if (!module.types().hasType(typeId)) {
            return "?" + typeId.toString();
        }
        return module.types().typeAt(typeId).name();
    }

    public static String functionName(SublangModule module, Int functionId) {
        if (!module.hasFunction(functionId)) {
            return "?fn" + functionId.toString();
        }
        return module.functionAt(functionId).name();
    }

    public static String failureName(SublangModule module, Int failureId) {
        if (!module.semantics().hasFailure(failureId)) {
            return "?failure" + failureId.toString();
        }
        return module.semantics().failureNameAt(failureId);
    }

    // A field is printed with its owner, so the same field name in two types stays distinct.
    public static String fieldName(SublangModule module, Int fieldId) {
        if (!module.types().hasField(fieldId)) {
            return "?field" + fieldId.toString();
        }
        SublangField fieldEntry = module.types().fieldAt(fieldId);
        return SublangDumpText.typeName(module, fieldEntry.owner()) + "." + fieldEntry.name();
    }
}
