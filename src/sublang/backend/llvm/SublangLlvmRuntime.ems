namespace sublang::backend::llvm;

// The first target explicitly binds abort/allocation/output to the host libc ABI.
// Checked helpers avoid LLVM poison/undefined division, including INT64_MIN / -1.
public class SublangLlvmRuntime {
    public static String definitions() {
        return "declare void @abort() noreturn\ndeclare ptr @malloc(i64)\ndeclare void @free(ptr)\ndeclare i32 @printf(ptr, ...)\n@sublang.format = private constant [6 x i8] c\"%lld\\0A\\00\"\n\ndefine internal ptr @sublang.allocate(i64 %size) {\nentry:\n  %memory = call ptr @malloc(i64 %size)\n  %failed = icmp eq ptr %memory, null\n  br i1 %failed, label %bad, label %ok\nbad:\n  call void @abort()\n  unreachable\nok:\n  ret ptr %memory\n}\ndeclare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)\ndefine internal i64 @sublang.add(i64 %left, i64 %right) alwaysinline {\nentry:\n  %pair = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %left, i64 %right)\n  %overflow = extractvalue { i64, i1 } %pair, 1\n  br i1 %overflow, label %bad, label %ok\nbad:\n  call void @abort()\n  unreachable\nok:\n  %result = extractvalue { i64, i1 } %pair, 0\n  ret i64 %result\n}\ndeclare { i64, i1 } @llvm.ssub.with.overflow.i64(i64, i64)\ndefine internal i64 @sublang.sub(i64 %left, i64 %right) alwaysinline {\nentry:\n  %pair = call { i64, i1 } @llvm.ssub.with.overflow.i64(i64 %left, i64 %right)\n  %overflow = extractvalue { i64, i1 } %pair, 1\n  br i1 %overflow, label %bad, label %ok\nbad:\n  call void @abort()\n  unreachable\nok:\n  %result = extractvalue { i64, i1 } %pair, 0\n  ret i64 %result\n}\ndeclare { i64, i1 } @llvm.smul.with.overflow.i64(i64, i64)\ndefine internal i64 @sublang.mul(i64 %left, i64 %right) alwaysinline {\nentry:\n  %pair = call { i64, i1 } @llvm.smul.with.overflow.i64(i64 %left, i64 %right)\n  %overflow = extractvalue { i64, i1 } %pair, 1\n  br i1 %overflow, label %bad, label %ok\nbad:\n  call void @abort()\n  unreachable\nok:\n  %result = extractvalue { i64, i1 } %pair, 0\n  ret i64 %result\n}\ndefine internal i64 @sublang.div.trap(i64 %left, i64 %right) alwaysinline {\nentry:\n  %zero = icmp eq i64 %right, 0\n  br i1 %zero, label %bad, label %nonzero\nbad:\n  call void @abort()\n  unreachable\nnonzero:\n  %min = icmp eq i64 %left, -9223372036854775808\n  %negative = icmp eq i64 %right, -1\n  %overflow = and i1 %min, %negative\n  br i1 %overflow, label %edge, label %ok\nedge:\n  call void @abort()\n  unreachable\nok:\n  %result = sdiv i64 %left, %right\n  ret i64 %result\n}\ndefine internal i64 @sublang.div.wrap(i64 %left, i64 %right) alwaysinline {\nentry:\n  %zero = icmp eq i64 %right, 0\n  br i1 %zero, label %bad, label %nonzero\nbad:\n  call void @abort()\n  unreachable\nnonzero:\n  %min = icmp eq i64 %left, -9223372036854775808\n  %negative = icmp eq i64 %right, -1\n  %overflow = and i1 %min, %negative\n  br i1 %overflow, label %edge, label %ok\nedge:\n  ret i64 -9223372036854775808\nok:\n  %result = sdiv i64 %left, %right\n  ret i64 %result\n}\ndefine internal i64 @sublang.rem.trap(i64 %left, i64 %right) alwaysinline {\nentry:\n  %zero = icmp eq i64 %right, 0\n  br i1 %zero, label %bad, label %nonzero\nbad:\n  call void @abort()\n  unreachable\nnonzero:\n  %min = icmp eq i64 %left, -9223372036854775808\n  %negative = icmp eq i64 %right, -1\n  %overflow = and i1 %min, %negative\n  br i1 %overflow, label %edge, label %ok\nedge:\n  call void @abort()\n  unreachable\nok:\n  %result = srem i64 %left, %right\n  ret i64 %result\n}\ndefine internal i64 @sublang.rem.zero(i64 %left, i64 %right) alwaysinline {\nentry:\n  %zero = icmp eq i64 %right, 0\n  br i1 %zero, label %bad, label %nonzero\nbad:\n  call void @abort()\n  unreachable\nnonzero:\n  %min = icmp eq i64 %left, -9223372036854775808\n  %negative = icmp eq i64 %right, -1\n  %overflow = and i1 %min, %negative\n  br i1 %overflow, label %edge, label %ok\nedge:\n  ret i64 0\nok:\n  %result = srem i64 %left, %right\n  ret i64 %result\n}\ndeclare double @llvm.experimental.constrained.fadd.f64(double, double, metadata, metadata)\ndeclare double @llvm.experimental.constrained.fsub.f64(double, double, metadata, metadata)\ndeclare double @llvm.experimental.constrained.fmul.f64(double, double, metadata, metadata)\ndeclare double @llvm.experimental.constrained.fdiv.f64(double, double, metadata, metadata)\n";
    }
}
