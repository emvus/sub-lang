namespace sublang::ir;

// Type table entry. Records are values; classes are identity-carrying objects
// reached only through Ref<Class>. A Ref points at its class via targetId.
public class SublangType {
    private Int typeIdValue;
    private String kindName;
    private String nameText;
    private Int widthBits;
    private Bool signedFlag;
    private Int targetId;
    private Bool nullableFlag;
    private Int spanIdValue;
    private List<Int> fieldIds;

    public SublangType(Int id, String kind, String name, Int width, Bool signed, Int target, Int span) {
        this.typeIdValue = id;
        this.kindName = kind + "";
        this.nameText = name + "";
        this.widthBits = width;
        this.signedFlag = signed;
        this.targetId = target;
        this.nullableFlag = false;
        this.spanIdValue = span;
        this.fieldIds = List();
    }

    public Int id() {
        return this.typeIdValue;
    }

    public String kind() {
        return this.kindName;
    }

    public String name() {
        return this.nameText;
    }

    public Int width() {
        return this.widthBits;
    }

    public Bool isSigned() {
        return this.signedFlag;
    }

    public Int target() {
        return this.targetId;
    }

    public Bool nullable() {
        return this.nullableFlag;
    }

    public Void setNullable(Bool value) {
        this.nullableFlag = value;
    }

    public Int span() {
        return this.spanIdValue;
    }

    public List<Int> fields() {
        return this.fieldIds;
    }

    public Int fieldCount() {
        return this.fieldIds.length();
    }

    public Void addField(Int fieldId) {
        this.fieldIds.add(fieldId);
    }

    public Bool isClass() {
        return this.kindName == "Class";
    }

    public Bool isRecord() {
        return this.kindName == "Record";
    }

    public Bool isRef() {
        return this.kindName == "Ref";
    }

    public Bool isNominal() {
        return this.isClass() || this.isRecord();
    }
}
