namespace sublang::analysis;

use sublang::body::SublangFunction;
use sublang::checks::SublangDispatchChecks;
use sublang::checks::SublangFlowChecks;
use sublang::checks::SublangFunctionChecks;
use sublang::checks::SublangSemanticChecks;
use sublang::checks::SublangTypeChecks;
use sublang::diagnostics::SublangReport;
use sublang::analysis::SublangVerification;
use sublang::ir::SublangModule;

// Entry point of the structural and semantic verifier. It runs the checks in a fixed order:
// module-level data, then types, then each function. Every run uses a new report, so the
// result of an earlier run cannot change because of a later one.
public class SublangVerifier {
    private SublangModule module;

    public SublangVerifier(SublangModule target) {
        this.module = target;
    }

    public SublangVerification verify() {
        SublangReport report = SublangReport(this.module.revision());
        SublangSemanticChecks semantics = SublangSemanticChecks(report, this.module);
        SublangTypeChecks types = SublangTypeChecks(report, this.module);
        this.checkModuleData(report, semantics, types);
        this.checkFunctions(report, semantics);
        this.checkEntryFunction(report);
        return SublangVerification(report.diagnostics());
    }

    private Void checkModuleData(SublangReport report, SublangSemanticChecks semantics, SublangTypeChecks types) {
        semantics.checkFailureActions();
        semantics.checkEffectSummaries();
        semantics.checkLocations();
        semantics.checkAliasFacts();
        types.checkTypes();
        types.checkFields();
        SublangDispatchChecks(report, this.module).check();
    }

    private Void checkFunctions(SublangReport report, SublangSemanticChecks semantics) {
        SublangFunctionChecks functions = SublangFunctionChecks(report, this.module);
        SublangFlowChecks flow = SublangFlowChecks(report, this.module);
        Int functionId = 1;
        while (functionId <= this.module.functionCount()) {
            this.checkFunction(report, semantics, functions, flow, functionId);
            functionId = functionId + 1;
        }
    }

    // Signature first, then the body: a function whose signature is broken still gets its
    // body checked, so that one run reports every problem it can see.
    private Void checkFunction(SublangReport report, SublangSemanticChecks semantics, SublangFunctionChecks functions, SublangFlowChecks flow, Int functionId) {
        SublangFunction fnEntry = this.module.functionAt(functionId);
        report.enterFunction(functionId);
        functions.checkReturnType(fnEntry);
        semantics.checkFunctionReferences(fnEntry);
        functions.checkDeclaration(fnEntry);
        functions.checkParams(fnEntry);
        functions.checkValues(fnEntry);
        if (fnEntry.definition() == "contract") {
            functions.checkContract(fnEntry);
            report.leaveFunction();
            return;
        }
        flow.checkBody(fnEntry);
        report.leaveFunction();
    }

    // The entry point is checked at module level, after every function has been examined.
    private Void checkEntryFunction(SublangReport report) {
        Int entry = this.module.entryFunction();
        if (entry == 0) {
            return;
        }
        if (!this.module.hasFunction(entry)) {
            report.report("SUBLANG-S002", "entry function id is not defined", 0);
        }
    }
}
